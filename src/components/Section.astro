---
interface Props {
  title?: string;
  eyebrow?: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  class?: string;
  id?: string;
}
const { title, eyebrow, description, href, linkLabel = 'View all', class: className, id } = Astro.props;
---

<section class:list={['py-16 sm:py-20', className]} id={id}>
  {
    (title || eyebrow) && (
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div class="max-w-2xl">
          {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
          {title && (
            <h2 class="font-display text-4xl font-semibold leading-[1.05] tracking-tight text-fg sm:text-5xl">
              {title}
            </h2>
          )}
          {description && <p class="mt-3 text-fg-muted">{description}</p>}
        </div>
        {href && (
          <a href={href} class="link-arrow shrink-0 text-sm font-medium">
            {linkLabel} <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    )
  }
  <slot />
</section>
