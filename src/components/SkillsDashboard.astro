---
import { getProfile } from '@lib/content';
import { getGithubStats } from '@lib/github';

const { data: profile } = await getProfile();
const gh = await getGithubStats();
const all = profile.skills.flatMap((g) => g.items.map((s) => ({ s, g: g.group })));
---

<div class="card p-6 sm:p-8" data-skills>
  <div class="flex flex-wrap gap-2" role="group" aria-label="Filter skills by category">
    <button type="button" class="pill" data-group="" aria-pressed="true">All ({all.length})</button>
    {
      profile.skills.map((g) => (
        <button type="button" class="pill" data-group={g.group} aria-pressed="false">
          {g.group} ({g.items.length})
        </button>
      ))
    }
  </div>
  <ul class="mt-6 flex flex-wrap gap-2">
    {
      all.map(({ s, g }) => (
        <li
          class="skill-chip rounded-lg border border-line bg-bg-alt px-3 py-1.5 text-sm font-medium text-fg-muted"
          data-group={g}
        >
          {s}
        </li>
      ))
    }
  </ul>
  <div class="mt-8 border-t border-line pt-6">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-fg-faint">Languages across public repos</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {
        gh.languages.map((l) => (
          <div>
            <div class="mb-1 flex justify-between text-xs text-fg-muted">
              <span>{l.name}</span>
              <span>{l.pct}%</span>
            </div>
            <div class="h-1.5 overflow-hidden rounded-full bg-bg-alt">
              <div class="h-full rounded-full" style={`width:${l.pct}%;background:${l.color}`} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-skills]').forEach((root) => {
    const pills = [...root.querySelectorAll<HTMLButtonElement>('[data-group].pill')];
    const chips = [...root.querySelectorAll<HTMLElement>('.skill-chip')];
    pills.forEach((p) =>
      p.addEventListener('click', () => {
        const g = p.dataset.group ?? '';
        pills.forEach((x) => x.setAttribute('aria-pressed', String(x === p)));
        chips.forEach((c) => (c.hidden = !!g && c.dataset.group !== g));
      }),
    );
  });
</script>
