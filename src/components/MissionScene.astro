---
/**
 * Fixed 3D voyage behind the homepage. The canvas is decoration only
 * (aria-hidden, pointer-events: none). Three.js loads after the page has
 * painted; until then, and when WebGL is unavailable, a CSS galaxy shows.
 */
---

<div class="mission-sky" aria-hidden="true">
  <canvas data-mission-canvas></canvas>
</div>

<style>
  .mission-sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(6% 4% at 72% 30%, rgb(255 241 214 / 0.9), transparent 70%),
      radial-gradient(30% 9% at 72% 30%, rgb(243 199 122 / 0.35), transparent 70%),
      radial-gradient(48% 16% at 72% 30%, rgb(164 139 255 / 0.28), transparent 72%),
      radial-gradient(70% 50% at 15% 85%, rgb(76 194 255 / 0.1), transparent 70%),
      linear-gradient(180deg, #05061a, #070814 55%, #04050f);
  }
  canvas {
    display: block;
    height: 100%;
    width: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  canvas.is-ready {
    opacity: 1;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-mission-canvas]');
  if (canvas) {
    const boot = async () => {
      const { startMissionScene } = await import('../scripts/mission-scene');
      const ids = [...document.querySelectorAll<HTMLElement>('[data-chapter]')].map((el) => el.dataset.chapter!);
      if (startMissionScene(canvas, ids)) canvas.classList.add('is-ready');
    };
    const later = (cb: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 1500 }) : setTimeout(cb, 300);
    if (document.readyState === 'complete') later(boot);
    else addEventListener('load', () => later(boot), { once: true });
  }
</script>
