---
/**
 * Original layered illustration for the newsletter hero: a night sky with the
 * Andromeda galaxy rising over the hills, warm-lit clouds, a shooting star and
 * a small figure on a hill looking up. Pure inline SVG (sharp at any size, no
 * image download). Layers marked data-depth drift with pointer/scroll.
 * Decorative only: aria-hidden and pointer-events: none.
 */
// Deterministic pseudo-random so the sky is identical on every build.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 170 }, () => {
  const y = Math.pow(rnd(), 1.4) * 520;
  return { x: rnd() * 1600, y, r: 0.4 + rnd() * (y < 260 ? 1.5 : 0.9), o: 0.35 + rnd() * 0.6, tw: rnd() < 0.22 };
});
// Dust and star points that make up the galaxy's spiral arms.
const galaxy = Array.from({ length: 260 }, () => {
  const arm = rnd() < 0.5 ? 0 : Math.PI;
  const t = rnd();
  const ang = arm + t * 3.4 + (rnd() - 0.5) * 0.55;
  const rad = 8 + t * 190 + (rnd() - 0.5) * 18;
  return {
    x: Math.cos(ang) * rad,
    y: Math.sin(ang) * rad * 0.34,
    r: 0.4 + rnd() * 1.3,
    o: 0.25 + (1 - t) * 0.6,
    c: rnd() < 0.45 ? '#bfa8ff' : rnd() < 0.5 ? '#9fd6ff' : '#fff1d6',
  };
});
// Cloud banks: many overlapping puffs, lit as one mass (gradient in user space).
const bank = (cx: number, cy: number, w: number, h: number, n: number) =>
  Array.from({ length: n }, (_, i) => {
    const t = i / (n - 1);
    const x = cx - w / 2 + t * w + (rnd() - 0.5) * 40;
    const lift = Math.sin(t * Math.PI) * h;
    const r = 34 + rnd() * 46 + Math.sin(t * Math.PI) * 40;
    return { x, y: cy - lift * (0.55 + rnd() * 0.45) + r * 0.35, r };
  });
const clouds = [
  {
    id: 'l',
    y0: 150,
    y1: 520,
    puffs: [...bank(150, 470, 420, 260, 16), ...bank(380, 500, 300, 120, 10), ...bank(60, 340, 200, 180, 8)],
    depth: 0.45,
    cls: 'cloud-l',
  },
  {
    id: 'r',
    y0: 90,
    y1: 520,
    puffs: [...bank(1430, 470, 420, 320, 16), ...bank(1210, 505, 300, 110, 10), ...bank(1540, 260, 160, 160, 8)],
    depth: 0.45,
    cls: 'cloud-r',
  },
  { id: 'c', y0: 380, y1: 560, puffs: bank(560, 560, 260, 60, 9), depth: 0.55, cls: 'cloud-c' },
];
const flowers = Array.from({ length: 90 }, () => ({
  x: rnd() * 1600,
  y: 760 + rnd() * 140,
  r: 0.8 + rnd() * 2,
  c: ['#f3c77a', '#ffb4c8', '#d7c8ff', '#fff3e0'][Math.floor(rnd() * 4)],
}));
---

<svg
  class="night-scene"
  viewBox="0 0 1600 900"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="ns-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#060a24"></stop>
      <stop offset="0.38" stop-color="#14204f"></stop>
      <stop offset="0.6" stop-color="#3a3d73"></stop>
      <stop offset="0.72" stop-color="#b9798a"></stop>
      <stop offset="0.8" stop-color="#f2b483"></stop>
    </linearGradient>
    <radialGradient id="ns-core" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fffaf0"></stop>
      <stop offset="0.12" stop-color="#ffe6b0" stop-opacity="0.95"></stop>
      <stop offset="0.35" stop-color="#d9a8ff" stop-opacity="0.45"></stop>
      <stop offset="0.7" stop-color="#7b8cff" stop-opacity="0.14"></stop>
      <stop offset="1" stop-color="#4cc2ff" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="ns-cloud" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffe3c4"></stop>
      <stop offset="0.45" stop-color="#f2a985"></stop>
      <stop offset="1" stop-color="#5b5a86"></stop>
    </linearGradient>
    <linearGradient id="ns-cloud-shadow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3b3f73" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#27295a" stop-opacity="0.85"></stop>
    </linearGradient>
    <linearGradient id="ns-hill-far" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4a5684"></stop>
      <stop offset="1" stop-color="#2b3460"></stop>
    </linearGradient>
    <linearGradient id="ns-hill-mid" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2c4a4a"></stop>
      <stop offset="1" stop-color="#16262e"></stop>
    </linearGradient>
    <linearGradient id="ns-hill-near" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2f5a3f"></stop>
      <stop offset="0.45" stop-color="#173027"></stop>
      <stop offset="1" stop-color="#070814"></stop>
    </linearGradient>
    <linearGradient id="ns-meteor" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#fff"></stop>
    </linearGradient>
    <radialGradient id="ns-glow" cx="0.5" cy="1" r="0.6">
      <stop offset="0" stop-color="#ffc58a" stop-opacity="0.75"></stop>
      <stop offset="1" stop-color="#ffc58a" stop-opacity="0"></stop>
    </radialGradient>
    <!-- Painterly edges for clouds, and a film-grain overlay. -->
    <filter id="ns-fluff" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.012 0.02" numOctaves="4" seed="4"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="38"></feDisplacementMap>
      <feGaussianBlur stdDeviation="1.6"></feGaussianBlur>
    </filter>
    <filter id="ns-soft"><feGaussianBlur stdDeviation="6"></feGaussianBlur></filter>
    <filter id="ns-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
  </defs>

  <rect width="1600" height="900" fill="url(#ns-sky)"></rect>

  <g data-depth="0.15">
    {
      stars.map((s) => (
        <circle
          cx={s.x.toFixed(1)}
          cy={s.y.toFixed(1)}
          r={s.r.toFixed(2)}
          fill="#fff"
          opacity={s.o.toFixed(2)}
          class={s.tw ? 'tw' : undefined}
        />
      ))
    }
  </g>

  <!-- Andromeda: tilted disc, glowing core, dust lane, spiral arms -->
  <g data-depth="0.3" class="galaxy">
    <g transform="translate(1040 205) rotate(-24)">
      <ellipse rx="300" ry="96" fill="url(#ns-core)" opacity="0.55" filter="url(#ns-soft)"></ellipse>
      <ellipse rx="170" ry="54" fill="url(#ns-core)" opacity="0.85"></ellipse>
      {
        galaxy.map((g) => (
          <circle cx={g.x.toFixed(1)} cy={g.y.toFixed(1)} r={g.r.toFixed(2)} fill={g.c} opacity={g.o.toFixed(2)} />
        ))
      }
      <path
        d="M-210 10 Q-60 34 90 14 T240 -6"
        stroke="#1a1640"
        stroke-width="7"
        fill="none"
        opacity="0.45"
        filter="url(#ns-soft)"></path>
      <ellipse rx="22" ry="9" fill="#fffaf0"></ellipse>
      <circle cx="120" cy="-62" r="7" fill="#ffe9c9" opacity="0.6" filter="url(#ns-soft)"></circle>
      <circle cx="-70" cy="44" r="5" fill="#ffe9c9" opacity="0.55" filter="url(#ns-soft)"></circle>
    </g>
  </g>

  <g class="meteor">
    <line x1="430" y1="120" x2="560" y2="170" stroke="url(#ns-meteor)" stroke-width="2" stroke-linecap="round"></line>
  </g>

  <!-- Horizon glow -->
  <ellipse cx="800" cy="640" rx="760" ry="150" fill="url(#ns-glow)" opacity="0.6"></ellipse>

  <!-- Clouds, lit from the horizon -->
  {
    clouds.map((c) => (
      <g data-depth={c.depth} class={`cloud ${c.cls}`}>
        <linearGradient id={`ns-cl-${c.id}`} gradientUnits="userSpaceOnUse" x1="0" y1={c.y0} x2="0" y2={c.y1}>
          <stop offset="0" stop-color="#ffe9cf" />
          <stop offset="0.4" stop-color="#f6b98f" />
          <stop offset="0.75" stop-color="#b98a96" />
          <stop offset="1" stop-color="#4a4a7c" />
        </linearGradient>
        <g filter="url(#ns-fluff)">
          {c.puffs.map((p) => (
            <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r={p.r.toFixed(1)} fill={`url(#ns-cl-${c.id})`} />
          ))}
        </g>
      </g>
    ))
  }

  <!-- Hills -->
  <g data-depth="0.6">
    <path d="M0 600 C 220 540 380 560 560 610 S 900 640 1040 600 S 1380 530 1600 560 V900 H0Z" fill="url(#ns-hill-far)"
    ></path>
    <!-- A distant launch site glowing in the valley -->
    <g opacity="0.9">
      <circle cx="800" cy="628" r="26" fill="#ffd39a" opacity="0.25" filter="url(#ns-soft)"></circle>
      <rect x="796" y="596" width="3" height="32" fill="#ffe2b8"></rect>
      <rect x="790" y="604" width="2" height="24" fill="#ffd39a" opacity="0.8"></rect>
      <circle cx="797.5" cy="594" r="2" fill="#fff"></circle>
      <rect x="770" y="626" width="60" height="3" rx="1.5" fill="#ffcf8f" opacity="0.8"></rect>
    </g>
  </g>
  <g data-depth="0.8">
    <path
      d="M0 610 C 160 600 300 640 450 700 C 560 744 680 760 800 760 C 920 760 1040 742 1150 700 C 1300 640 1440 600 1600 600 V900 H0Z"
      fill="url(#ns-hill-mid)"></path>
  </g>
  <g data-depth="1">
    <path
      d="M0 700 C 240 690 420 720 640 770 C 720 790 760 792 800 792 C 840 792 880 790 960 770 C 1180 720 1360 690 1600 700 V900 H0Z"
      fill="url(#ns-hill-near)"></path>
    <!-- The traveller, sitting on the hill and looking up -->
    <g transform="translate(728 752)">
      <ellipse cx="10" cy="22" rx="24" ry="4" fill="#000" opacity="0.35"></ellipse>
      <path d="M-4 20 C -6 8 0 -2 10 -2 C 20 -2 25 8 24 20 Z" fill="#0b0f1e"></path>
      <circle cx="11" cy="-11" r="8.5" fill="#0b0f1e"></circle>
      <path d="M17 -16 C 20 -12 20 -7 18 -4" stroke="#ffcf9a" stroke-width="1.2" fill="none" opacity="0.7"></path>
      <path d="M20 14 L36 20 L34 23 L18 19 Z" fill="#0b0f1e"></path>
    </g>
    {
      flowers.map((f) => (
        <circle cx={f.x.toFixed(1)} cy={f.y.toFixed(1)} r={f.r.toFixed(2)} fill={f.c} opacity="0.55" />
      ))
    }
  </g>

  <rect width="1600" height="900" filter="url(#ns-grain)" opacity="0.07" class="grain"></rect>
</svg>

<style>
  .night-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: block;
  }
  .night-scene [data-depth] {
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: transform;
  }
  .tw {
    animation: twinkle 3.6s ease-in-out infinite;
  }
  .tw:nth-child(3n) {
    animation-delay: -1.2s;
  }
  .tw:nth-child(3n + 1) {
    animation-delay: -2.4s;
  }
  @keyframes twinkle {
    50% {
      opacity: 0.15;
    }
  }
  .galaxy {
    animation: galaxy-breathe 9s ease-in-out infinite;
    transform-origin: 1040px 205px;
  }
  @keyframes galaxy-breathe {
    50% {
      opacity: 0.86;
    }
  }
  .meteor {
    opacity: 0;
    animation: meteor 9s ease-in 2s infinite;
  }
  @keyframes meteor {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    3% {
      opacity: 1;
    }
    9% {
      opacity: 0;
      transform: translate(260px, 100px);
    }
    100% {
      opacity: 0;
      transform: translate(260px, 100px);
    }
  }
  .cloud-l > g {
    animation: drift 28s ease-in-out infinite alternate;
  }
  .cloud-r > g,
  .cloud-c > g {
    animation: drift 34s ease-in-out infinite alternate-reverse;
  }
  @keyframes drift {
    to {
      transform: translateX(26px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tw,
    .galaxy,
    .meteor,
    .cloud-l > g,
    .cloud-r > g,
    .cloud-c > g {
      animation: none;
    }
    .meteor {
      opacity: 0;
    }
  }
</style>
