---
/** Home · Archive · Products · About tabs, shared by every newsletter page. */
interface Props {
  active: 'home' | 'archive' | 'products' | 'about';
}
const { active } = Astro.props;
const tabs = [
  { id: 'home', label: 'Home', href: '/newsletter' },
  { id: 'archive', label: 'Archive', href: '/newsletter/archive' },
  { id: 'products', label: 'Products', href: '/newsletter/products' },
  { id: 'about', label: 'About', href: '/newsletter/about' },
] as const;
---

<nav class="nl-tabs" aria-label="Newsletter sections">
  <ul class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-4 sm:gap-2 sm:px-6">
    {
      tabs.map((t) => (
        <li>
          <a href={t.href} class="nl-tab" aria-current={t.id === active ? 'page' : undefined}>
            {t.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .nl-tabs {
    position: sticky;
    top: 4rem;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1px solid var(--border);
  }
  .nl-tabs ul {
    scrollbar-width: none;
  }
  .nl-tab {
    position: relative;
    display: inline-flex;
    padding: 0.95rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--fg-faint);
    white-space: nowrap;
    transition: color 200ms ease;
  }
  .nl-tab:hover {
    color: var(--fg);
  }
  .nl-tab[aria-current='page'] {
    color: var(--fg);
  }
  .nl-tab[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }
</style>
