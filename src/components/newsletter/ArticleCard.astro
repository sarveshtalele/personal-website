---
/**
 * Newsletter article card. Variants:
 *  - card:     cover on top, topic chip, title, summary, date · read time
 *  - row:      small square thumbnail beside title and meta (the "Latest" list)
 *  - featured: full-bleed cover with the title over a soft gradient
 * Carries data-* attributes the archive filters read.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, slugifyTag } from '@utils/format';

interface Props {
  article: CollectionEntry<'newsletter'>;
  minutes?: number;
  variant?: 'card' | 'row' | 'featured';
  eager?: boolean;
}
const { article, minutes = 1, variant = 'card', eager = false } = Astro.props;
const { title, description, pubDate, tags, cover, coverAlt } = article.data;
const href = `/newsletter/${article.id}`;
const topic = tags[0];
const data = {
  'data-article': '',
  'data-topics': tags.map(slugifyTag).join(','),
  'data-text': `${title} ${description} ${tags.join(' ')}`.toLowerCase(),
  'data-date': pubDate.toISOString(),
  'data-year': String(pubDate.getFullYear()),
  'data-min': String(minutes),
};
---

{
  variant === 'featured' && (
    <article class="feat group" {...data}>
      {cover ? (
        <Image
          src={cover}
          alt={coverAlt}
          widths={[640, 960, 1400]}
          sizes="(min-width: 1024px) 62vw, 100vw"
          loading={eager ? 'eager' : 'lazy'}
          class="feat-img"
        />
      ) : (
        <div class="feat-img feat-fallback" aria-hidden="true" />
      )}
      <div class="feat-shade" aria-hidden="true" />
      <div class="feat-body">
        {topic && (
          <span class="dot-chip dot-chip-light">
            <i />
            {topic}
          </span>
        )}
        <h3 class="feat-title">
          <a href={href} class="after:absolute after:inset-0 after:content-['']">
            {title}
          </a>
        </h3>
        <p class="feat-meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span aria-hidden="true">•</span>
          {minutes} min read
        </p>
      </div>
    </article>
  )
}

{
  variant === 'row' && (
    <article class="row group" {...data}>
      <div class="row-thumb">
        {cover ? (
          <Image src={cover} alt="" widths={[160, 320]} sizes="80px" class="h-full w-full object-cover" />
        ) : (
          <div class="h-full w-full feat-fallback" aria-hidden="true" />
        )}
      </div>
      <div class="min-w-0">
        <h3 class="row-title">
          <a href={href} class="after:absolute after:inset-0 after:content-['']">
            {title}
          </a>
        </h3>
        <p class="meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span aria-hidden="true">•</span>
          {minutes} min read
        </p>
      </div>
    </article>
  )
}

{
  variant === 'card' && (
    <article class="acard group" {...data}>
      <div class="acard-thumb">
        {cover ? (
          <Image
            src={cover}
            alt={coverAlt}
            widths={[400, 640, 960]}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
          />
        ) : (
          <div class="h-full w-full feat-fallback" aria-hidden="true" />
        )}
      </div>
      <div class="acard-body">
        {topic && (
          <span class="dot-chip">
            <i />
            {topic}
          </span>
        )}
        <h3 class="acard-title">
          <a href={href} class="after:absolute after:inset-0 after:content-['']">
            {title}
          </a>
        </h3>
        <p class="acard-desc">{description}</p>
        <p class="meta mt-auto pt-3">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span aria-hidden="true">•</span>
          {minutes} min read
        </p>
      </div>
    </article>
  )
}

<style>
  article {
    position: relative;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--fg-faint);
  }
  .dot-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    border-radius: 9999px;
    background: var(--accent-soft);
    padding: 0.3rem 0.7rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
  }
  .dot-chip i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: currentColor;
  }
  .dot-chip-light {
    background: rgb(255 255 255 / 0.92);
    color: #4b2fc9;
  }
  .feat-fallback {
    background:
      radial-gradient(60% 80% at 75% 20%, rgb(164 139 255 / 0.55), transparent 60%),
      radial-gradient(50% 70% at 20% 80%, rgb(243 199 122 / 0.45), transparent 65%), #141733;
  }

  /* Featured */
  .feat {
    overflow: hidden;
    border-radius: 1.5rem;
    min-height: 22rem;
    height: 100%;
    background: #10132b;
    box-shadow: var(--shadow-card);
  }
  .feat-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .feat:hover .feat-img {
    transform: scale(1.03);
  }
  .feat-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(8 10 30 / 0.92) 0%, rgb(8 10 30 / 0.55) 32%, transparent 62%);
  }
  .feat-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    color: #fff;
  }
  @media (min-width: 768px) {
    .feat {
      min-height: 26rem;
    }
    .feat-body {
      padding: 2rem;
    }
  }
  .feat-title {
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .feat-meta {
    display: flex;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: rgb(255 255 255 / 0.8);
  }

  /* Row */
  .row {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 0.5rem;
    margin: -0.5rem;
    border-radius: 1rem;
    transition: background-color 200ms ease;
  }
  .row:hover {
    background: var(--bg-alt);
  }
  .row-thumb {
    width: 5rem;
    height: 5rem;
    flex: none;
    overflow: hidden;
    border-radius: 0.85rem;
    background: var(--bg-alt);
  }
  .row-title {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--fg);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .row:hover .row-title {
    color: var(--accent);
  }
  .row .meta {
    margin-top: 0.35rem;
  }

  /* Card */
  .acard {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0.5rem;
    border-radius: 1.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    transition:
      transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 300ms ease,
      border-color 300ms ease;
  }
  .acard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--border-strong);
  }
  .acard-thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--bg-alt);
  }
  .acard-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem 0.75rem 0.75rem;
  }
  .acard-title {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-wrap: balance;
  }
  .acard:hover .acard-title {
    color: var(--accent);
  }
  .acard-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
