---
import { Mail } from '@lucide/astro';
import GithubIcon from './icons/GithubIcon.astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';
import MediumIcon from './icons/MediumIcon.astro';
import OrcidIcon from './icons/OrcidIcon.astro';
import { NAV_LINKS, FOOTER_LINKS } from '@lib/site';
import { getProfile } from '@lib/content';

const { data: profile } = await getProfile();
const year = new Date().getFullYear();
const quote = profile.quotes[0];
const socials = [
  { href: profile.socials.github, label: 'GitHub', Icon: GithubIcon },
  { href: profile.socials.linkedin, label: 'LinkedIn', Icon: LinkedinIcon },
  { href: profile.socials.medium, label: 'Medium', Icon: MediumIcon },
  { href: profile.socials.orcid, label: 'ORCID', Icon: OrcidIcon },
].filter((s) => s.href);
---

<footer class="relative mt-24 border-t border-line bg-bg-alt/70">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="mx-auto max-w-2xl text-center font-display text-2xl italic leading-snug text-fg-muted sm:text-3xl">
      “{quote.text}”
    </p>
    <p class="mt-3 text-center text-xs uppercase tracking-[0.25em] text-fg-faint">{quote.author}</p>
    <div class="ornament my-12" aria-hidden="true"><span class="font-display text-lg">❦</span></div>

    <div class="grid gap-10 sm:grid-cols-[1.4fr_1fr_1fr]">
      <div class="max-w-sm">
        <p class="font-display text-2xl font-semibold text-fg">{profile.name}</p>
        <p class="mt-2 text-sm text-fg-muted">{profile.role}. {profile.location}.</p>
        <div class="mt-5 flex flex-wrap items-center gap-1">
          {
            socials.map(({ href, label, Icon }) => (
              <a href={href} class="footer-icon" aria-label={label} rel="me noopener noreferrer" target="_blank">
                <Icon class="h-[18px] w-[18px]" />
              </a>
            ))
          }
          <a href={`mailto:${profile.email}`} class="footer-icon" aria-label="Email">
            <Mail class="h-[18px] w-[18px]" aria-hidden="true" />
          </a>
        </div>
      </div>
      <nav aria-label="Primary footer navigation" class="flex flex-col gap-2 text-sm">
        <p class="eyebrow mb-1">Explore</p>
        {
          NAV_LINKS.map((l) => (
            <a href={l.href} class="footer-link">
              {l.label}
            </a>
          ))
        }
      </nav>
      <nav aria-label="Secondary footer navigation" class="flex flex-col gap-2 text-sm">
        <p class="eyebrow mb-1">More</p>
        {
          FOOTER_LINKS.map((l) => (
            <a href={l.href} class="footer-link">
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-line pt-6 text-xs text-fg-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {profile.fullName}. All rights reserved.</p>
      <p>Written in Markdown, built with Astro, served from GitHub Pages.</p>
    </div>
  </div>
</footer>

<style>
  .footer-icon {
    display: inline-flex;
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    border: 1px solid var(--border);
    color: var(--fg-muted);
    transition: all 200ms ease;
  }
  .footer-icon:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .footer-link {
    width: fit-content;
    color: var(--fg-muted);
    transition: color 200ms ease;
  }
  .footer-link:hover {
    color: var(--accent);
  }
</style>
