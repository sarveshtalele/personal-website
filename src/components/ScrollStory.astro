---
/**
 * "How I work": stacking cards. Each step is a sticky card; as the next card
 * slides up over it, the one underneath scales back and dims, like a deck.
 * Works on touch screens (pure scroll + position: sticky). Steps come from
 * `approach:` in src/content/profile/sarvesh.md.
 */
import { getProfile } from '@lib/content';

const { data: profile } = await getProfile();
const steps = profile.approach;
---

{
  steps.length > 0 && (
    <section class="mx-auto max-w-5xl px-4 py-20 sm:px-6 sm:py-28" data-stack aria-labelledby="stack-title">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow justify-center">My process</p>
        <h2 id="stack-title" class="mt-3 font-display text-4xl font-bold leading-tight text-fg sm:text-5xl">
          How I like to work.
        </h2>
      </div>
      <ol class="stack mt-14">
        {steps.map((s, i) => (
          <li class="stack-item" style={`--i:${i}`} data-stack-item>
            <article class:list={['stack-card', `tone-${i % 4}`]} data-stack-card>
              <span class="stack-glow" aria-hidden="true" />
              <span class="stack-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="relative pr-20 sm:pr-36">
                <div class="max-w-xl">
                  <p class="text-sm font-semibold text-accent">
                    Step {String(i + 1).padStart(2, '0')} of {String(steps.length).padStart(2, '0')}
                  </p>
                  <h3 class="mt-3 font-display text-3xl font-bold leading-tight text-fg sm:text-4xl">{s.title}</h3>
                  <p class="mt-4 text-lg leading-relaxed text-fg-muted">{s.text}</p>
                </div>
              </div>
              <div class="stack-progress" aria-hidden="true">
                {steps.map((_, k) => (
                  <span class:list={['dot', k <= i && 'on']} />
                ))}
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .stack {
    display: grid;
    gap: 1.5rem;
    padding-bottom: 6vh;
  }
  .stack-item {
    position: sticky;
    top: calc(5.5rem + var(--i) * 1.1rem);
  }
  .stack-card {
    position: relative;
    overflow: hidden;
    min-height: clamp(18rem, 46vh, 24rem);
    border-radius: 1.75rem;
    border: 1px solid var(--border);
    background: var(--card);
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow:
      0 -10px 40px -20px rgb(0 0 0 / 0.25),
      var(--shadow-card);
    transform-origin: 50% 0%;
    transform: scale(var(--s, 1));
    filter: brightness(var(--b, 1));
    will-change: transform;
  }
  .stack-glow {
    position: absolute;
    right: -15%;
    top: -35%;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 9999px;
    filter: blur(60px);
    opacity: 0.22;
    animation: glow-drift 12s ease-in-out infinite;
  }
  :global(.dark) .stack-glow {
    opacity: 0.18;
  }
  .tone-0 .stack-glow {
    background: var(--accent);
  }
  .tone-1 .stack-glow {
    background: var(--primary);
  }
  .tone-2 .stack-glow {
    background: color-mix(in srgb, var(--accent) 60%, var(--primary));
  }
  .tone-3 .stack-glow {
    background: var(--primary-strong);
  }
  @keyframes glow-drift {
    50% {
      transform: translate(-12%, 14%) scale(1.15);
    }
  }
  .stack-num {
    position: absolute;
    right: clamp(1.25rem, 4vw, 3rem);
    top: clamp(1rem, 3vw, 2.25rem);
    font-size: clamp(3.25rem, 9vw, 6.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(160deg, var(--accent), var(--primary));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.9;
  }
  .stack-progress {
    position: absolute;
    left: clamp(1.5rem, 4vw, 3rem);
    top: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    gap: 0.35rem;
    translate: 0 -0.9rem;
  }
  .dot {
    height: 4px;
    width: 1.25rem;
    border-radius: 9999px;
    background: var(--border);
  }
  .dot.on {
    background: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .stack-glow {
      animation: none;
    }
    .stack-card {
      transform: none;
      filter: none;
    }
  }
</style>

<script>
  // As each following card slides over a card, shrink and dim the one below.
  const root = document.querySelector<HTMLElement>('[data-stack]');
  if (root && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-stack-item]')];
    const cards = items.map((it) => it.querySelector<HTMLElement>('[data-stack-card]')!);
    let ticking = false;
    const update = () => {
      ticking = false;
      for (let i = 0; i < items.length - 1; i++) {
        const top = items[i].getBoundingClientRect().top;
        const nextTop = items[i + 1].getBoundingClientRect().top;
        const h = cards[i].offsetHeight || 1;
        const p = Math.min(Math.max(1 - (nextTop - top) / h, 0), 1);
        const depth = items.length - 1 - i;
        cards[i].style.setProperty('--s', String(1 - p * 0.04 * Math.min(depth, 3)));
        cards[i].style.setProperty('--b', String(1 - p * 0.18));
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  }
</script>
