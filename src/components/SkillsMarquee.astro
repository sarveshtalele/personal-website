---
/** Two counter-scrolling rows of skills from the profile, as a motion strip. */
import { getProfile } from '@lib/content';

const { data: profile } = await getProfile();
const all = profile.skills.flatMap((g) => g.items);
const half = Math.ceil(all.length / 2);
const rows = [all.slice(0, half), all.slice(half)];
---

<section class="border-y border-line py-6" aria-label="Skills and tools">
  <ul class="sr-only">{all.map((s) => <li>{s}</li>)}</ul>
  {
    rows.map((row, r) => (
      <div class:list={['marquee', r === 1 && 'mt-3']} aria-hidden="true">
        {[0, 1].map(() => (
          <ul class:list={['marquee-track', r === 1 && 'marquee-reverse']}>
            {row.map((s) => (
              <li class="skill-pill">{s}</li>
            ))}
          </ul>
        ))}
      </div>
    ))
  }
</section>

<style>
  .skill-pill {
    white-space: nowrap;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 0.45rem 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--fg-muted);
  }
  .marquee-track {
    gap: 0.75rem;
    padding-right: 0.75rem;
    animation-duration: 45s;
  }
  .marquee-reverse {
    animation-direction: reverse;
    animation-duration: 55s;
  }
</style>
