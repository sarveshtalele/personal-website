---
/** "Follow on LinkedIn" call to action used across the newsletter. */
import LinkedinIcon from './icons/LinkedinIcon.astro';
import { getProfile } from '@lib/content';

interface Props {
  size?: 'md' | 'lg';
  label?: string;
}
const { size = 'md', label = 'Follow on LinkedIn' } = Astro.props;
const { data: profile } = await getProfile();
const pad = size === 'lg' ? 'px-6 py-3 text-[0.95rem]' : 'px-5 py-2.5 text-sm';
---

<a
  href={profile.socials.linkedin}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['follow-li inline-flex w-fit items-center gap-2 rounded-full font-semibold text-white', pad]}
>
  <LinkedinIcon class="h-4 w-4" />
  {label}
</a>

<style>
  .follow-li {
    background: #0a66c2;
    transition:
      background-color 200ms ease,
      transform 200ms ease;
  }
  .follow-li:hover {
    background: #004182;
    transform: translateY(-2px);
  }
</style>
