---
import { Search, Menu, X } from '@lucide/astro';
import GithubIcon from './icons/GithubIcon.astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV_LINKS } from '@lib/site';
import { getProfile } from '@lib/content';

const { data: profile } = await getProfile();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header class="site-header sticky top-0 z-50">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6" aria-label="Main navigation">
    <a href="/" class="group flex items-center gap-3" aria-label={`${profile.name}, home`}>
      <img
        src={profile.photo}
        alt=""
        width="36"
        height="36"
        class="avatar h-9 w-9 shrink-0 rounded-full object-cover"
      />
      <span class="hidden flex-col leading-none sm:flex">
        <span class="text-[0.95rem] font-semibold tracking-tight text-fg">{profile.name}</span>
        <span class="mt-0.5 text-xs text-fg-faint">AI Engineer</span>
      </span>
    </a>

    <ul class="hidden items-center gap-0.5 lg:flex">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class="nav-link">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <a
        href="/search"
        class="cmdk-btn hidden items-center gap-2 sm:inline-flex"
        data-cmdk-open
        aria-label="Open quick menu"
      >
        <Search class="h-4 w-4" aria-hidden="true" />
        <span class="text-xs">Search</span>
        <kbd class="rounded border border-line px-1 text-[0.65rem]">⌘K</kbd>
      </a>
      <a href="/search" class="icon-btn inline-flex sm:hidden" data-cmdk-open aria-label="Open quick menu">
        <Search class="h-[18px] w-[18px]" aria-hidden="true" />
      </a>
      <ThemeToggle />
      <a
        href={profile.socials.github}
        class="icon-btn hidden sm:inline-flex"
        aria-label="GitHub profile"
        rel="me noopener noreferrer"
        target="_blank"
      >
        <GithubIcon class="h-[18px] w-[18px]" />
      </a>
      <a
        href={profile.socials.linkedin}
        class="icon-btn hidden sm:inline-flex"
        aria-label="LinkedIn profile"
        rel="me noopener noreferrer"
        target="_blank"
      >
        <LinkedinIcon class="h-[18px] w-[18px]" />
      </a>
      <button
        id="mobile-menu-button"
        type="button"
        class="icon-btn inline-flex lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu class="menu-open-icon h-5 w-5" aria-hidden="true" />
        <X class="menu-close-icon hidden h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu lg:hidden" hidden>
    <ul class="mx-auto max-w-6xl space-y-1 px-4 py-6 sm:px-6">
      {
        NAV_LINKS.map((link, i) => (
          <li class:list={['mobile-item', `reveal-i-${Math.min(i + 1, 5)}`]}>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class="mobile-link font-display"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .site-header {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .avatar {
    box-shadow: 0 0 0 1px var(--border);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    border-radius: 0.6rem;
    padding: 0.5rem 0.8rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg-muted);
    transition: color 200ms ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.3rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 350ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .nav-link:hover {
    color: var(--fg);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav-link[aria-current='page'] {
    color: var(--primary);
  }
  .cmdk-btn {
    height: 2.25rem;
    border-radius: 9999px;
    border: 1px solid var(--border);
    padding: 0 0.75rem;
    color: var(--fg-faint);
    transition:
      border-color 200ms ease,
      color 200ms ease;
  }
  .cmdk-btn:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }
  .icon-btn {
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    color: var(--fg-muted);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }
  .icon-btn:hover {
    background: var(--bg-alt);
    color: var(--fg);
  }
  .mobile-menu {
    border-top: 1px solid var(--border);
    background: var(--bg);
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
  }
  .mobile-link {
    display: block;
    border-radius: 0.75rem;
    padding: 0.55rem 0.75rem;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .mobile-link[aria-current='page'] {
    color: var(--accent);
  }
  .mobile-item {
    animation: menu-in 500ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--reveal-i, 0) * 50ms);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  if (button && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      button.querySelector('.menu-open-icon')?.classList.toggle('hidden', open);
      button.querySelector('.menu-close-icon')?.classList.toggle('hidden', !open);
    };
    button.addEventListener('click', () => setOpen(menu.hasAttribute('hidden')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false);
    });
  }

  // "/" opens search from anywhere (except while typing).
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName) && !t.isContentEditable) {
      e.preventDefault();
      window.location.href = '/search';
    }
  });
</script>
