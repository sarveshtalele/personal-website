---
import { SITE, GA_MEASUREMENT_ID } from '@lib/site';
import { getProfile } from '@lib/content';
import '@styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { data: profile } = await getProfile();
const {
  title,
  description = profile.summary,
  image = '/og-home.png',
  type = 'website',
  pubDate,
  updatedDate,
  tags = [],
  jsonLd,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const fullTitle = title === SITE.name ? `${profile.name} · ${profile.role}` : `${title} · ${SITE.name}`;
const sameAs = Object.values(profile.socials).filter((v): v is string => !!v && v.startsWith('https://'));

// One reused Person entity; `sameAs` lets search and answer engines confirm
// this is the same verifiable person across the site, GitHub, and LinkedIn.
const personId = `${SITE.url}/#person`;
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId,
  name: profile.fullName,
  url: SITE.url,
  image: new URL(profile.photo, SITE.url).toString(),
  jobTitle: profile.role,
  worksFor: { '@type': 'Organization', name: profile.employer },
  knowsAbout: profile.skills.flatMap((g) => g.items).slice(0, 20),
  sameAs,
};

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'BlogPosting' : 'WebSite',
  url: canonicalURL.toString(),
  name: fullTitle,
  headline: title,
  description,
  image: imageURL.toString(),
  ...(type === 'article'
    ? {
        author: { '@id': personId },
        keywords: tags.join(', '),
        ...(pubDate && { datePublished: pubDate.toISOString() }),
        ...(updatedDate && { dateModified: updatedDate.toISOString() }),
      }
    : { publisher: { '@id': personId } }),
};

const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [personJsonLd, pageJsonLd];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={profile.fullName} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="theme-color" content="#f6f0e4" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#14100c" media="(prefers-color-scheme: dark)" />
<meta name="format-detection" content="telephone=no" />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} · Blog`} href="/rss.xml" />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />
<meta property="og:locale" content="en_US" />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

{jsonLdBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />)}

<!-- Theme + motion flags applied before first paint (no flash). -->
<script is:inline>
  (function () {
    const d = document.documentElement;
    let stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {
      /* storage blocked */
    }
    const dark = stored ? stored === 'dark' : true; // dark by default
    d.classList.toggle('dark', dark);
    d.classList.add('js');
  })();
</script>

{
  GA_MEASUREMENT_ID && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`} is:inline />
      <script
        is:inline
        set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','${GA_MEASUREMENT_ID}');`}
      />
    </>
  )
}
