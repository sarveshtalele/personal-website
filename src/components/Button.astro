---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  external?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', external = false, class: className } = Astro.props;

const variants = {
  primary: 'btn-primary',
  secondary: 'border border-line-strong bg-surface/70 text-fg hover:border-accent hover:text-primary',
  ghost: 'text-fg-muted hover:bg-bg-alt hover:text-fg',
};
const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-[0.95rem]',
};
---

<a
  href={href}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  class:list={[
    'relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5',
    sizes[size],
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
