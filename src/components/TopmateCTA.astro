---
import { ArrowRight } from '@lucide/astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';
import { getProfile } from '@lib/content';

const { data: profile } = await getProfile();
---

<div class="card px-6 py-14 text-center sm:px-12 sm:py-20" data-reveal>
  <p class="eyebrow justify-center">Let's talk</p>
  <h2 class="mx-auto mt-3 max-w-2xl font-display text-4xl font-bold leading-tight text-fg sm:text-5xl">
    Have a hard problem? <span class="text-primary">Let's make it simple.</span>
  </h2>
  <p class="mx-auto mt-5 max-w-xl text-lg text-fg-muted">
    Roles, architecture reviews, Claude certification prep, or a conversation about agentic AI.
  </p>
  <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
    {
      profile.socials.topmate && (
        <a
          href={profile.socials.topmate}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-flex items-center gap-2 rounded-full px-6 py-3 text-[0.95rem] font-medium"
        >
          Book a 1:1 on Topmate <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>
      )
    }
    <a
      href={profile.socials.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full border border-line-strong px-6 py-3 text-[0.95rem] font-medium text-fg transition-colors hover:border-accent"
    >
      <LinkedinIcon class="h-4 w-4" /> Connect on LinkedIn
    </a>
  </div>
</div>
