---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { ArrowUpRight } from '@lucide/astro';
import { formatDate, slugifyTag } from '@utils/format';
import { issueLabel } from '@lib/newsletter';

interface Props {
  issue: CollectionEntry<'newsletter'> & { issueNo: number };
  minutes?: number;
  /** Large lead layout for the latest issue. */
  lead?: boolean;
}
const { issue, minutes, lead = false } = Astro.props;
const { title, description, pubDate, tags, cover, coverAlt } = issue.data;
---

<article
  class:list={['issue-card card card-hover group relative flex h-full flex-col overflow-hidden', lead && 'lg:flex-row']}
  data-issue
  data-topics={tags.map(slugifyTag).join(',')}
  data-text={`${title} ${description} ${tags.join(' ')}`.toLowerCase()}
>
  {
    cover && (
      <div
        class:list={[
          'relative overflow-hidden bg-bg-alt',
          lead ? 'aspect-[16/9] lg:aspect-auto lg:w-[55%]' : 'aspect-[16/9]',
        ]}
      >
        <Image
          src={cover}
          alt={coverAlt}
          widths={[480, 800, 1200]}
          sizes={lead ? '(min-width: 1024px) 55vw, 100vw' : '(min-width: 1024px) 33vw, 100vw'}
          class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]"
        />
      </div>
    )
  }
  <div class:list={['flex flex-1 flex-col p-6', lead && 'lg:p-10']}>
    <p class="flex flex-wrap items-center gap-x-2 text-xs font-semibold text-accent">
      <span>{issueLabel(issue.issueNo)}</span>
      <span class="text-fg-faint" aria-hidden="true">·</span>
      <time datetime={pubDate.toISOString()} class="font-medium text-fg-faint">{formatDate(pubDate)}</time>
      {minutes && <span class="font-medium text-fg-faint">· {minutes} min read</span>}
    </p>
    <h3 class:list={['mt-3 font-bold leading-tight tracking-tight text-fg', lead ? 'text-3xl sm:text-4xl' : 'text-xl']}>
      <a
        href={`/newsletter/${issue.id}`}
        class="after:absolute after:inset-0 after:content-[''] group-hover:text-primary"
      >
        {title}
      </a>
    </h3>
    <p class:list={['mt-3 flex-1 leading-relaxed text-fg-muted', lead ? 'text-lg' : 'text-sm']}>{description}</p>
    <div class="mt-5 flex flex-wrap items-center gap-1.5">
      {tags.slice(0, 4).map((t) => <span class="chip">{t}</span>)}
      <ArrowUpRight
        class="ml-auto h-5 w-5 text-accent transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        aria-hidden="true"
      />
    </div>
  </div>
</article>
