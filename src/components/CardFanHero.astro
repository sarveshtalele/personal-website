---
/**
 * Landing hero: a deck of portfolio cards fanned around a slowly turning
 * wheel, above a dashed "PORTFOLIO" ring. Every card is built from content
 * (profile, pinned repos, posts, certifications, dashboard metrics), so the
 * deck updates itself when the Markdown changes.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Star, ArrowUpRight } from '@lucide/astro';
import { getProfile, getPosts, getDashboard } from '@lib/content';
import { getGithubStats } from '@lib/github';
import { byDateDesc } from '@utils/format';
import claudeStats from '../data/claude-stats.json';

const { data: profile } = await getProfile();
const dashboard = await getDashboard();
const gh = await getGithubStats();
const [post] = await getPosts();
const certs = (await getCollection('certifications'))
  .filter((c) => c.data.featured && c.data.badge)
  .sort(byDateDesc((c) => c.data.date));

type Card =
  | { kind: 'photo' }
  | { kind: 'badge'; src: string; href: string; label: string }
  | { kind: 'repo'; name: string; text: string; stars: number; lang: string | null; href: string }
  | { kind: 'stat'; value: string; label: string; href: string; tone: 'light' | 'gold' }
  | { kind: 'exam' }
  | { kind: 'blog' };

const repos = gh.pinned.slice(0, 4);
const stats = dashboard.impact.slice(0, 3);
const badge = certs[0];

// Order matters: the photo sits at the top of the arc on load, flanked by the
// Claude card and a project, like the reference deck.
const deck: Card[] = [
  { kind: 'photo' },
  ...(badge
    ? [{ kind: 'badge' as const, src: badge.data.badge!, href: '/claude', label: `Claude Certified ×${certs.length}` }]
    : []),
  ...(repos[0] ? [repoCard(repos[0])] : []),
  ...(stats[1] ? [statCard(stats[1], 'gold')] : []),
  ...(post ? [{ kind: 'blog' as const }] : []),
  ...(repos[1] ? [repoCard(repos[1])] : []),
  { kind: 'exam' },
  ...(stats[0] ? [statCard(stats[0], 'light')] : []),
  ...(repos[2] ? [repoCard(repos[2])] : []),
  ...(stats[2] ? [statCard(stats[2], 'gold')] : []),
  ...(repos[3] ? [repoCard(repos[3])] : []),
];
// The photo should start at 12 o'clock: put it in the middle of the list,
// since cards are laid out from -180° to +180°.
const half = Math.floor(deck.length / 2);
const ordered = [...deck.slice(1, half + 1).reverse(), deck[0], ...deck.slice(half + 1)];
const step = 360 / ordered.length;
const startIndex = ordered.findIndex((c) => c.kind === 'photo');

function repoCard(r: (typeof repos)[number]): Card {
  return {
    kind: 'repo',
    name: r.name.replace(/[-_]/g, ' '),
    text: r.description,
    stars: r.stars,
    lang: r.language,
    href: r.url,
  };
}
function statCard(s: (typeof stats)[number], tone: 'light' | 'gold'): Card {
  return { kind: 'stat', value: s.value, label: s.label, href: s.proof, tone };
}
const ext = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {});
const ring = `PORTFOLIO • ${profile.name.toUpperCase()} • ${profile.heroLabel.toUpperCase()} • `;
---

<section class="fan" data-fan aria-label={`${profile.name}, ${profile.heroLabel}. Portfolio highlights.`}>
  <div class="fan-label fan-label-l" aria-hidden="true">
    <span>{profile.name}</span>
    <span class="text-fg-faint">{profile.location}</span>
  </div>
  <div class="fan-label fan-label-r" aria-hidden="true">
    <span>{profile.heroLabel}</span>
    <span class="text-fg-faint">Portfolio ’{String(new Date().getFullYear()).slice(2)}</span>
  </div>

  <div class="wheel-tilt">
    <ul class="wheel" data-wheel>
      {
        ordered.map((card, i) => (
          <li class="slot" style={`--a:${(i - startIndex) * step}deg;--d:${Math.abs(i - startIndex)}`}>
            {card.kind === 'photo' && (
              <a href="/about" class="deal card-photo">
                <img src={profile.photo} alt={profile.fullName} width="400" height="530" loading="eager" />
                <span class="corner-tag">
                  {profile.name
                    .split(' ')
                    .map((p) => p[0])
                    .join('')}
                  <br />
                  AI·ENG
                </span>
                <span class="card-foot text-white">{profile.name}</span>
              </a>
            )}
            {card.kind === 'badge' && (
              <a href={card.href} class="deal card-accent">
                <span class="tri tri-top" aria-hidden="true" />
                <img src={card.src} alt="" width="200" height="200" class="mx-auto w-3/5 drop-shadow-xl" />
                <span class="mt-4 block text-center text-sm font-semibold">{card.label}</span>
                <span class="tri tri-bottom" aria-hidden="true" />
              </a>
            )}
            {card.kind === 'repo' && (
              <a href={card.href} class="deal card-dark" {...ext(card.href)}>
                <span class="orb" aria-hidden="true" />
                <span class="text-[0.6rem] uppercase tracking-[0.2em] opacity-60">Project</span>
                <span class="mt-auto block text-xl font-bold leading-tight tracking-tight">{card.name}</span>
                <span class="mt-2 line-clamp-3 block text-xs opacity-70">{card.text}</span>
                <span class="mt-3 flex items-center gap-2 text-xs opacity-80">
                  <Star class="h-3 w-3" aria-hidden="true" />
                  {card.stars}
                  {card.lang && <span class="opacity-70">· {card.lang}</span>}
                  <ArrowUpRight class="ml-auto h-4 w-4" aria-hidden="true" />
                </span>
              </a>
            )}
            {card.kind === 'stat' && (
              <a
                href={card.href}
                class:list={['deal', card.tone === 'gold' ? 'card-gold' : 'card-light']}
                {...ext(card.href)}
              >
                <span class="text-[0.6rem] uppercase tracking-[0.2em] opacity-60">Impact</span>
                <span class="mt-auto block text-5xl font-bold tracking-tight">{card.value}</span>
                <span class="mt-2 block text-sm font-medium leading-snug">{card.label}</span>
              </a>
            )}
            {card.kind === 'exam' && (
              <a href="/claude/quiz" class="deal card-light">
                <span class="text-[0.6rem] uppercase tracking-[0.2em] opacity-60">Claude Prep</span>
                <span class="mt-auto block text-5xl font-bold tracking-tight">{claudeStats.total}</span>
                <span class="mt-2 block text-sm font-medium leading-snug">
                  Free CCAR-F practice questions + {claudeStats.mock}-question mock exam
                </span>
              </a>
            )}
            {card.kind === 'blog' && post && (
              <a href={`/blog/${post.id}`} class="deal card-blog">
                {post.data.cover && (
                  <Image
                    src={post.data.cover}
                    alt=""
                    widths={[400, 600]}
                    sizes="260px"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                )}
                <span class="relative mt-auto block rounded-xl bg-black/55 p-3 text-sm font-semibold leading-snug text-white backdrop-blur">
                  {post.data.title}
                </span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="ring" aria-hidden="true">
    <svg class="ring-dash" viewBox="0 0 400 400"><circle cx="200" cy="200" r="198" /></svg>
    <svg class="ring-text" viewBox="0 0 400 400">
      <defs>
        <path id="fan-ring" d="M200,200 m-170,0 a170,170 0 1,1 340,0 a170,170 0 1,1 -340,0"></path>
      </defs>
      <text><textPath href="#fan-ring" textLength="1060">{ring.repeat(2)}</textPath></text>
    </svg>
  </div>
  <a href="#intro" class="me-link">
    <span class="tri-up" aria-hidden="true"></span>
    ME
  </a>
</section>

<style>
  .fan {
    --h: clamp(560px, 86svh, 920px);
    --r: min(clamp(330px, 56vw, 780px), calc(var(--h) * 0.78));
    --w: clamp(160px, 17vw, 250px);
    --ch: calc(var(--w) * 1.36);
    --drop: calc(var(--r) * 0.16);
    position: relative;
    height: var(--h);
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(
      80% 70% at 50% 100%,
      color-mix(in srgb, var(--accent) 12%, transparent),
      transparent 70%
    );
  }
  .fan-label {
    position: absolute;
    top: 1.5rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg);
    animation: fade-in 1s 0.6s both;
  }
  .fan-label-l {
    left: clamp(1rem, 4vw, 3rem);
  }
  .fan-label-r {
    right: clamp(1rem, 4vw, 3rem);
    text-align: right;
  }

  /* The wheel: its centre sits just below the fold; cards orbit it. */
  .wheel-tilt {
    position: absolute;
    left: 50%;
    top: calc(var(--h) + var(--drop));
    width: 0;
    height: 0;
    transform: rotate(calc(var(--px, 0) * 6deg));
    transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .wheel {
    position: absolute;
    inset: 0;
    animation: wheel-spin 160s linear infinite;
  }
  .fan:hover .wheel,
  .fan:focus-within .wheel {
    animation-play-state: paused;
  }
  @keyframes wheel-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .slot {
    position: absolute;
    left: calc(var(--w) / -2);
    top: calc(var(--ch) / -2);
    width: var(--w);
    height: var(--ch);
    transform: rotate(var(--a)) translateY(calc(var(--r) * -1));
  }

  /* Each card is dealt in from below, staggered outward from the photo. */
  .deal {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    overflow: hidden;
    border-radius: calc(var(--w) * 0.1);
    padding: calc(var(--w) * 0.09);
    box-shadow:
      0 30px 60px -25px rgb(0 0 0 / 0.45),
      0 10px 20px -10px rgb(0 0 0 / 0.2);
    animation: deal 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    animation-delay: calc(var(--d) * 90ms + 150ms);
    transition:
      transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 450ms ease;
  }
  .deal:hover,
  .deal:focus-visible {
    transform: translateY(-18px) scale(1.04);
    box-shadow:
      0 40px 80px -25px rgb(0 0 0 / 0.55),
      0 14px 28px -12px rgb(0 0 0 / 0.25);
  }
  @keyframes deal {
    from {
      opacity: 0;
      transform: translateY(160px) rotate(-8deg) scale(0.85);
    }
  }

  .card-photo {
    padding: 0;
    background: #d9d4cc;
  }
  .card-photo img {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: filter 600ms ease;
  }
  .card-photo:hover img {
    filter: grayscale(0) contrast(1);
  }
  .corner-tag {
    position: absolute;
    right: 0.8rem;
    top: 0.8rem;
    transform: rotate(18deg);
    font-size: 0.65rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0.08em;
    color: #111;
    text-align: right;
  }
  .card-foot {
    position: absolute;
    left: 0.9rem;
    bottom: 0.8rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
  }
  .card-accent {
    justify-content: center;
    background: var(--primary);
    color: var(--on-primary);
  }
  .tri {
    position: absolute;
    left: 50%;
    width: 0;
    height: 0;
    margin-left: -6px;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
  }
  .tri-top {
    top: 0.9rem;
    border-top: 8px solid currentColor;
  }
  .tri-bottom {
    bottom: 0.9rem;
    border-bottom: 8px solid currentColor;
  }
  .card-dark {
    background: #15100c;
    color: #f2e8d8;
    outline: 1px solid rgb(255 255 255 / 0.08);
    outline-offset: -1px;
  }
  .orb {
    position: absolute;
    left: 50%;
    top: 34%;
    width: 70%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: radial-gradient(circle, rgb(217 183 126 / 0.55), rgb(166 124 61 / 0.15) 45%, transparent 70%);
    animation: orb-pulse 6s ease-in-out infinite;
  }
  @keyframes orb-pulse {
    50% {
      transform: translate(-50%, -50%) scale(1.12);
      opacity: 0.75;
    }
  }
  .card-light {
    background: #fbf8f2;
    color: #1d150f;
  }
  .card-gold {
    background: linear-gradient(160deg, #e3c58c, #b48a4c);
    color: #1d150f;
  }
  .card-blog {
    background: #15100c;
    padding: 0.7rem;
  }

  /* Dashed ring with slowly counter-rotating text. */
  .ring {
    position: absolute;
    left: 50%;
    top: calc(var(--h) + var(--drop));
    width: calc(var(--r) * 1.1);
    height: calc(var(--r) * 1.1);
    transform: translate(-50%, -50%);
    border-radius: 9999px;
    z-index: -1;
    animation: fade-in 1.2s 0.4s both;
  }
  .ring-dash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ring-dash circle {
    fill: none;
    stroke: color-mix(in srgb, var(--fg) 30%, transparent);
    stroke-width: 1.4;
    stroke-dasharray: 6 9;
    vector-effect: non-scaling-stroke;
  }
  .ring-text {
    position: absolute;
    inset: 9%;
    width: 82%;
    height: 82%;
    animation: wheel-spin 90s linear infinite reverse;
  }
  .ring-text text {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 4px;
    fill: color-mix(in srgb, var(--fg) 28%, transparent);
  }
  .me-link {
    position: absolute;
    left: calc(50% + var(--r) * 0.24);
    top: calc(var(--h) + var(--drop) - var(--r) * 0.5);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    transform: rotate(18deg);
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    font-weight: 900;
    letter-spacing: 0.02em;
    color: var(--fg);
    animation: fade-in 1s 1s both;
  }
  .me-link:hover {
    color: var(--primary);
  }
  .tri-up {
    width: 0;
    height: 0;
    border-left: 9px solid transparent;
    border-right: 9px solid transparent;
    border-bottom: 13px solid currentColor;
    animation: bob 2.4s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(-5px);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  @media (max-width: 640px) {
    .fan {
      --h: 600px;
      --r: 340px;
      --w: 168px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wheel,
    .ring-text,
    .orb,
    .tri-up {
      animation: none;
    }
  }
</style>

<script>
  // Gentle parallax: the whole deck leans toward the pointer.
  const fan = document.querySelector<HTMLElement>('[data-fan]');
  if (fan && !matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(pointer: fine)').matches) {
    fan.addEventListener('pointermove', (e) => {
      const r = fan.getBoundingClientRect();
      fan.style.setProperty('--px', ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
    });
    fan.addEventListener('pointerleave', () => fan.style.setProperty('--px', '0'));
  }
</script>
