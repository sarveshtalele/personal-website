---
import { ArrowRight } from '@lucide/astro';
import Button from './Button.astro';
import { getProfile } from '@lib/content';

const { data: profile } = await getProfile();
const [line1, line2, line3] = profile.headline.split(/(?<=\.)\s+/);
const quote = profile.quotes[0];
---

<section class="hero relative overflow-hidden">
  <div class="mx-auto flex max-w-4xl flex-col items-center px-4 pb-20 pt-16 text-center sm:px-6 sm:pt-24">
    <img
      src={profile.photo}
      alt={profile.fullName}
      width="160"
      height="160"
      fetchpriority="high"
      decoding="async"
      class="hero-in h-32 w-32 rounded-full object-cover shadow-xl ring-1 ring-line sm:h-40 sm:w-40"
    />

    <p class="hero-in hero-d1 mt-8 text-base font-semibold text-accent sm:text-lg">{profile.heroLabel}</p>

    <h1 class="hero-in hero-d2 mt-3 font-display text-[clamp(2.5rem,7vw,4.75rem)] font-bold leading-[1.04] text-fg">
      {line1 ?? profile.headline}
      {line2 && <span class="block">{line2}</span>}
      {line3 && <span class="block text-primary">{line3}</span>}
    </h1>

    <p class="hero-in hero-d3 mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-fg-muted sm:text-xl">
      {profile.tagline}
    </p>

    {
      quote && (
        <figure class="hero-in hero-d4 mx-auto mt-10 max-w-xl">
          <blockquote class="text-lg leading-relaxed text-fg-muted italic sm:text-xl">“{quote.text}”</blockquote>
          <figcaption class="mt-3 text-sm text-fg-faint">
            {quote.author}
            {quote.source && <span> · {quote.source}</span>}
          </figcaption>
        </figure>
      )
    }

    <div class="hero-in hero-d5 mt-10 flex flex-wrap items-center justify-center gap-3">
      <Button href="/dashboard" size="lg">
        See the evidence <ArrowRight class="h-4 w-4" aria-hidden="true" />
      </Button>
      <Button href="/projects" variant="secondary" size="lg">Explore projects</Button>
      {
        profile.socials.topmate && (
          <Button href={profile.socials.topmate} variant="ghost" size="lg" external>
            Book a call
          </Button>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    background: radial-gradient(70% 60% at 50% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%);
  }
  .hero-in {
    animation: hero-fade 900ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  .hero-d1 {
    animation-delay: 80ms;
  }
  .hero-d2 {
    animation-delay: 160ms;
  }
  .hero-d3 {
    animation-delay: 240ms;
  }
  .hero-d4 {
    animation-delay: 320ms;
  }
  .hero-d5 {
    animation-delay: 400ms;
  }
</style>
