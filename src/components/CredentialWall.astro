---
import { getCollection } from 'astro:content';
import { BadgeCheck, ExternalLink, Award } from '@lucide/astro';
import { byDateDesc, formatDate } from '@utils/format';

interface Props {
  /** Only featured certifications (those with `featured: true`). */
  featuredOnly?: boolean;
}
const { featuredOnly = false } = Astro.props;
const certs = (await getCollection('certifications'))
  .filter((c) => !featuredOnly || c.data.featured)
  .sort(byDateDesc((c) => c.data.date));
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    certs.map((cert, i) => (
      <div class:list={['card flex items-start gap-4 p-5', `reveal-i-${(i % 5) + 1}`]} data-reveal>
        {cert.data.badge ? (
          <img
            src={cert.data.badge}
            alt={`${cert.data.title} badge`}
            width="72"
            height="72"
            loading="lazy"
            class="h-16 w-16 shrink-0 object-contain drop-shadow-md sm:h-[72px] sm:w-[72px]"
          />
        ) : (
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
            <Award class="h-5 w-5" aria-hidden="true" />
          </span>
        )}
        <div class="min-w-0">
          <p class="text-sm font-semibold leading-snug text-fg">{cert.data.title}</p>
          <p class="mt-1 text-xs text-fg-muted">
            {cert.data.issuer} · {formatDate(cert.data.date)}
          </p>
          {cert.data.credentialUrl && (
            <a href={cert.data.credentialUrl} target="_blank" rel="noopener noreferrer" class="verify-btn mt-3">
              <BadgeCheck class="h-3.5 w-3.5" aria-hidden="true" /> Verify on{' '}
              {new URL(cert.data.credentialUrl).hostname.replace('www.', '')}
              <ExternalLink class="h-3 w-3" aria-hidden="true" />
            </a>
          )}
        </div>
      </div>
    ))
  }
</div>
