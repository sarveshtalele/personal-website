---
/**
 * Credential cards: badge (or a fitting icon), title, short note, and a link
 * to the proof. Data: `credentials:` in src/content/profile/sarvesh.md.
 */
import { ArrowUpRight, FlaskConical, GraduationCap, Trophy, Award, BadgeCheck } from '@lucide/astro';
import { getProfile } from '@lib/content';

const { data: profile } = await getProfile();
function iconFor(label: string) {
  if (/arxiv|paper|publish|nasa/i.test(label)) return FlaskConical;
  if (/harvard|certificate|degree/i.test(label)) return GraduationCap;
  if (/guinness|record/i.test(label)) return Trophy;
  if (/award/i.test(label)) return Award;
  return BadgeCheck;
}
const external = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---

<ul class="grid grid-cols-1 gap-3 min-[480px]:grid-cols-2 lg:grid-cols-3" aria-label="Credentials">
  {
    profile.credentials.map((c, i) => {
      const Icon = iconFor(c.label);
      return (
        <li class={`reveal-i-${(i % 3) + 1}`} data-reveal>
          <a href={c.href} class="cred card card-hover group flex h-full items-center gap-4 p-4" {...external(c.href)}>
            <span class="cred-badge">
              {c.badge ? (
                <img src={c.badge} alt="" width="56" height="56" loading="lazy" class="h-12 w-12 object-contain" />
              ) : (
                <Icon class="h-6 w-6" aria-hidden="true" />
              )}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-[0.95rem] font-semibold leading-snug text-fg">{c.label}</span>
              {c.note && <span class="mt-0.5 block text-xs text-fg-muted">{c.note}</span>}
              <span class="mt-1.5 inline-flex items-center gap-1 text-xs font-semibold text-primary">
                {c.href.startsWith('http') ? 'Verify' : 'See details'}
                <ArrowUpRight
                  class="h-3.5 w-3.5 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </span>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .cred-badge {
    display: inline-flex;
    height: 3.5rem;
    width: 3.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cred:hover .cred-badge {
    transform: rotate(-6deg) scale(1.06);
  }
</style>
