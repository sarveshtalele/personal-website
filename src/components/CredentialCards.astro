---
/**
 * Credential cards: badge (or a fitting icon), title, short note, and a link
 * to the proof. Credentials with an `image` (e.g. a certificate photo) get a
 * "View certificate" button that opens it in a lightbox.
 * Data: `credentials:` in content/profile/sarvesh.md.
 */
import { ArrowUpRight, FlaskConical, GraduationCap, Trophy, Award, BadgeCheck, Expand, X } from '@lucide/astro';
import { getProfile } from '@lib/content';

const { data: profile } = await getProfile();
function iconFor(label: string) {
  if (/arxiv|paper|publish|nasa/i.test(label)) return FlaskConical;
  if (/harvard|certificate|degree/i.test(label)) return GraduationCap;
  if (/guinness|record/i.test(label)) return Trophy;
  if (/award/i.test(label)) return Award;
  return BadgeCheck;
}
const external = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---

<ul class="grid grid-cols-1 gap-3 min-[480px]:grid-cols-2 lg:grid-cols-3" aria-label="Credentials">
  {
    profile.credentials.map((c, i) => {
      const Icon = iconFor(c.label);
      return (
        <li class={`reveal-i-${(i % 3) + 1}`} data-reveal>
          <div class="cred card card-hover group relative flex h-full items-center gap-4 p-4">
            <span class="cred-badge">
              {c.badge ? (
                <img
                  src={c.badge}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                  class="h-12 w-12 rounded-lg object-contain"
                />
              ) : (
                <Icon class="h-6 w-6" aria-hidden="true" />
              )}
            </span>
            <span class="min-w-0 flex-1">
              <a
                href={c.href}
                class="block text-[0.95rem] font-semibold leading-snug text-fg after:absolute after:inset-0 after:content-['']"
                {...external(c.href)}
              >
                {c.label}
              </a>
              {c.note && <span class="mt-0.5 block text-xs text-fg-muted">{c.note}</span>}
              <span class="mt-1.5 flex flex-wrap items-center gap-3">
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-primary">
                  {c.href.startsWith('http') ? 'Verify' : 'See details'}
                  <ArrowUpRight
                    class="h-3.5 w-3.5 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                    aria-hidden="true"
                  />
                </span>
                {c.image && (
                  <button
                    type="button"
                    class="relative z-10 inline-flex items-center gap-1 text-xs font-semibold text-accent hover:underline"
                    data-lightbox={c.image}
                    data-lightbox-alt={c.imageAlt ?? c.label}
                  >
                    <Expand class="h-3.5 w-3.5" aria-hidden="true" /> View certificate
                  </button>
                )}
              </span>
            </span>
          </div>
        </li>
      );
    })
  }
</ul>

<dialog class="lightbox" data-lightbox-dialog aria-label="Certificate">
  <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">
    <X class="h-5 w-5" aria-hidden="true" />
  </button>
  <img src="" alt="" data-lightbox-img />
</dialog>

<style>
  .cred-badge {
    display: inline-flex;
    height: 3.5rem;
    width: 3.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cred:hover .cred-badge {
    transform: rotate(-6deg) scale(1.06);
  }
  .lightbox {
    max-width: min(64rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 1rem;
    background: transparent;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.75);
    backdrop-filter: blur(6px);
  }
  .lightbox[open] img {
    animation: lb-in 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .lightbox img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 2rem);
    border-radius: 1rem;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
  }
  .lightbox-close {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    display: grid;
    place-items: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 9999px;
    background: var(--card);
    color: var(--fg);
    box-shadow: var(--shadow-card-hover);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  if (dlg) {
    const img = dlg.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((b) =>
      b.addEventListener('click', () => {
        img.src = b.dataset.lightbox!;
        img.alt = b.dataset.lightboxAlt ?? '';
        dlg.showModal();
      }),
    );
    dlg.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
  }
</script>
