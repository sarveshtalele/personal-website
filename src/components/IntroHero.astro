---
/**
 * Homepage hero, "Departure": the first view from the cockpit. Role, the quote
 * rising in word by word, the headline, two buttons, mission tags, socials,
 * and a launch cue. No photo here (it lives in the newsletter); the 3D voyage
 * behind the page is the visual.
 */
import { ArrowRight, BadgeCheck, Star, ShieldCheck, Cloud, Wrench, Sparkles, ChevronDown } from '@lucide/astro';
import { getCollection } from 'astro:content';
import Button from './Button.astro';
import GithubIcon from './icons/GithubIcon.astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';
import MediumIcon from './icons/MediumIcon.astro';
import OrcidIcon from './icons/OrcidIcon.astro';
import { getProfile } from '@lib/content';
import { getGithubStats } from '@lib/github';

const { data: profile } = await getProfile();
const gh = await getGithubStats();
const certCount = (await getCollection('certifications')).filter((c) =>
  c.data.title.includes('Claude Certified Architect'),
).length;
const quote = profile.quotes[0];
const words = quote ? quote.text.split(' ') : [];
const [line1, line2, line3] = profile.headline.split(/(?<=\.)\s+/);
function chipIcon(label: string) {
  if (/secur/i.test(label)) return ShieldCheck;
  if (/cloud|azure|aws|gcp/i.test(label)) return Cloud;
  if (/harness|test|eval/i.test(label)) return Wrench;
  return Sparkles;
}
const socials = [
  { href: profile.socials.github, label: 'GitHub', Icon: GithubIcon },
  { href: profile.socials.linkedin, label: 'LinkedIn', Icon: LinkedinIcon },
  { href: profile.socials.medium, label: 'Medium', Icon: MediumIcon },
  { href: profile.socials.orcid, label: 'ORCID', Icon: OrcidIcon },
].filter((x) => x.href);
---

<section id="intro" class="hero relative">
  <div class="intro mx-auto flex max-w-6xl flex-col justify-center px-4 sm:px-6" data-intro>
    <p class="status fade-up">
      <span class="status-dot" aria-hidden="true"></span>
      <span>Departure</span>
      <span class="status-sep" aria-hidden="true">/</span>
      <span>{profile.location}</span>
      <span class="status-sep" aria-hidden="true">/</span>
      <span>Destination: Andromeda</span>
    </p>

    <p class="eyebrow mt-8">{profile.role}</p>
    {
      quote && (
        <figure class="mt-5 max-w-4xl">
          <h1 class="quote text-[clamp(2.2rem,5.6vw,4.6rem)] font-bold leading-[1.04] tracking-[-0.03em] text-fg">
            {words.map((w, i) => (
              <span class="word" style={`--i:${i}`}>
                {w}{' '}
              </span>
            ))}
          </h1>
          <figcaption class="cap mt-5 text-sm text-fg-faint">
            <span class="cap-line" aria-hidden="true" />
            {quote.author}
            {quote.source && <span> · {quote.source}</span>}
          </figcaption>
        </figure>
      )
    }
    <p class="fade-up mt-9 max-w-2xl text-xl font-semibold leading-snug tracking-tight text-fg sm:text-2xl">
      {line1}
      {line2 && <> {line2}</>}
      {line3 && <span class="text-primary"> {line3}</span>}
    </p>
    <p class="fade-up mt-4 max-w-xl text-lg leading-relaxed text-fg-muted">{profile.tagline}</p>
    <div class="fade-up mt-9 flex flex-wrap gap-3">
      <Button href="/newsletter" size="lg">
        Read the newsletter <ArrowRight class="h-4 w-4" aria-hidden="true" />
      </Button>
      <Button href="/projects" variant="secondary" size="lg">Explore projects</Button>
    </div>

    <ul class="tags fade-up mt-10" aria-label="Highlights">
      <li>
        <a href="/claude" class="tag">
          <BadgeCheck class="h-4 w-4 text-primary" aria-hidden="true" /> Claude Certified ×{certCount}
        </a>
      </li>
      <li>
        <a href={gh.profileUrl} target="_blank" rel="noopener noreferrer" class="tag">
          <Star class="h-4 w-4 text-primary" aria-hidden="true" />
          {gh.stars} GitHub stars
        </a>
      </li>
      {
        profile.heroChips.map((label) => {
          const Icon = chipIcon(label);
          return (
            <li>
              <span class="tag">
                <Icon class="h-4 w-4 text-ion" aria-hidden="true" /> {label}
              </span>
            </li>
          );
        })
      }
    </ul>

    <div class="fade-up mt-8 flex items-center gap-1">
      {
        socials.map(({ href, label, Icon }) => (
          <a href={href} class="social" aria-label={label} target="_blank" rel="me noopener noreferrer">
            <Icon class="h-5 w-5" />
          </a>
        ))
      }
    </div>

    <a href="#proof" class="launch fade-up" aria-label="Start the voyage: scroll to credentials">
      <span>Scroll to launch</span>
      <ChevronDown class="h-4 w-4" aria-hidden="true" />
    </a>
  </div>
</section>

<style>
  .intro {
    min-height: calc(100svh - 4rem);
    padding-block: 3.5rem 5rem;
    position: relative;
  }
  .status {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 60%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 0.4rem 0.9rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .status-dot {
    height: 0.45rem;
    width: 0.45rem;
    border-radius: 9999px;
    background: var(--success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 25%, transparent);
    animation: blink 2s ease-in-out infinite;
  }
  .status-sep {
    color: var(--fg-faint);
  }
  @keyframes blink {
    50% {
      opacity: 0.35;
    }
  }
  .word {
    display: inline-block;
    white-space: pre;
  }
  :global(.js) .intro:not(.is-in) .word,
  :global(.js) .intro:not(.is-in) .fade-up,
  :global(.js) .intro:not(.is-in) .cap {
    opacity: 0;
    transform: translateY(0.6em);
  }
  .word,
  .fade-up,
  .cap {
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .word {
    transition-delay: calc(var(--i) * 45ms);
  }
  .cap {
    transition-delay: 0.8s;
  }
  .fade-up {
    transition-delay: 1s;
  }
  .status.fade-up {
    transition-delay: 0s;
  }
  .cap-line {
    display: inline-block;
    width: 2rem;
    height: 1px;
    margin-right: 0.6rem;
    vertical-align: middle;
    background: var(--primary);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 0.8rem;
    border: 1px solid rgb(150 140 255 / 0.2);
    background: color-mix(in srgb, var(--card) 55%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 0.5rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--fg);
    transition: border-color 200ms ease;
  }
  a.tag:hover {
    border-color: var(--primary);
  }
  .social {
    display: inline-flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.8rem;
    color: var(--fg-muted);
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }
  .social:hover {
    color: var(--fg);
    background: var(--bg-alt);
  }
  .launch {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    translate: -50% 0;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .launch :global(svg) {
    animation: nudge 1.8s ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(5px);
    }
  }
  @media (max-width: 640px) {
    .launch {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-dot,
    .launch :global(svg) {
      animation: none;
    }
  }
</style>

<script>
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  if (intro) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          intro.classList.add('is-in');
          io.disconnect();
        }
      },
      { threshold: 0.2 },
    );
    io.observe(intro);
  }
</script>
