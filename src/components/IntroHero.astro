---
/**
 * Landing hero in the site's original format: text on the left (role,
 * headline, tagline, quote rising in word by word, buttons) and the portrait
 * on the right, with self-drawing lines, drifting colour, floating proof
 * chips, and social links below. No surrounding box.
 */
import { ArrowRight, BadgeCheck, Star, ShieldCheck, Cloud, Wrench, Sparkles } from '@lucide/astro';
import { getCollection } from 'astro:content';
import Button from './Button.astro';
import GithubIcon from './icons/GithubIcon.astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';
import MediumIcon from './icons/MediumIcon.astro';
import OrcidIcon from './icons/OrcidIcon.astro';
import { getProfile } from '@lib/content';
import { getGithubStats } from '@lib/github';

const { data: profile } = await getProfile();
const gh = await getGithubStats();
const certCount = (await getCollection('certifications')).filter((c) =>
  c.data.title.includes('Claude Certified Architect'),
).length;
const quote = profile.quotes[0];
const words = quote ? quote.text.split(' ') : [];
const [line1, line2, line3] = profile.headline.split(/(?<=\.)\s+/);
// Pick a fitting icon for a hero chip from its text; anything else gets a sparkle.
function chipIcon(label: string) {
  if (/secur/i.test(label)) return ShieldCheck;
  if (/cloud|azure|aws|gcp/i.test(label)) return Cloud;
  if (/harness|test|eval/i.test(label)) return Wrench;
  return Sparkles;
}
const socials = [
  { href: profile.socials.github, label: 'GitHub', Icon: GithubIcon },
  { href: profile.socials.linkedin, label: 'LinkedIn', Icon: LinkedinIcon },
  { href: profile.socials.medium, label: 'Medium', Icon: MediumIcon },
  { href: profile.socials.orcid, label: 'ORCID', Icon: OrcidIcon },
].filter((x) => x.href);
---

<section id="intro" class="hero relative overflow-hidden border-b border-line">
  <div class="intro mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:py-24" data-intro>
    <div class="flex flex-col-reverse items-center gap-12 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
      <div class="max-w-2xl">
        <p class="eyebrow">{profile.role}</p>
        {
          quote && (
            <figure class="mt-5">
              <h1 class="quote font-display text-[clamp(2rem,4.4vw,3.4rem)] font-bold leading-[1.1] text-fg">
                {words.map((w, i) => (
                  <span class="word" style={`--i:${i}`}>
                    {w}{' '}
                  </span>
                ))}
              </h1>
              <figcaption class="cap mt-4 text-sm text-fg-faint">
                <span class="cap-line" aria-hidden="true" />
                {quote.author}
                {quote.source && <span> · {quote.source}</span>}
              </figcaption>
            </figure>
          )
        }
        <p class="fade-up mt-8 text-xl font-semibold leading-snug tracking-tight text-fg sm:text-2xl">
          {line1}
          {line2 && <> {line2}</>}
          {line3 && <span class="text-primary"> {line3}</span>}
        </p>
        <p class="fade-up mt-4 max-w-xl text-lg leading-relaxed text-fg-muted">{profile.tagline}</p>
        <div class="fade-up mt-9 flex flex-wrap gap-3">
          <Button href="/blog" size="lg">
            Read the blog <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </Button>
          <Button href="/projects" variant="secondary" size="lg">Explore projects</Button>
        </div>
      </div>

      <div class="flex shrink-0 flex-col items-center gap-5">
        <div class="portrait relative aspect-[4/5] w-64 sm:w-72 lg:w-[21rem]">
          <div class="blob blob-a" aria-hidden="true"></div>
          <div class="blob blob-b" aria-hidden="true"></div>
          <svg class="lines" viewBox="0 0 400 500" preserveAspectRatio="none" aria-hidden="true">
            <path d="M-60 430 C 120 360, 180 500, 460 300"></path>
            <path d="M-60 110 C 140 40, 260 210, 460 80"></path>
          </svg>
          <div class="frame">
            <img
              src={profile.photo}
              alt={profile.fullName}
              width="420"
              height="525"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <a href="/claude" class="chip-float chip-1">
            <BadgeCheck class="h-4 w-4 text-accent" aria-hidden="true" /> Claude Certified ×{certCount}
          </a>
          <a href={gh.profileUrl} target="_blank" rel="noopener noreferrer" class="chip-float chip-2">
            <Star class="h-4 w-4 text-accent" aria-hidden="true" />
            {gh.stars} stars
          </a>
          {
            profile.heroChips.map((label, i) => {
              const Icon = chipIcon(label);
              return (
                <span class:list={['chip-float', `chip-${i + 3}`]}>
                  <Icon class="h-4 w-4 text-accent" aria-hidden="true" /> {label}
                </span>
              );
            })
          }
        </div>
        <div class="fade-up flex items-center gap-1">
          {
            socials.map(({ href, label, Icon }) => (
              <a href={href} class="social" aria-label={label} target="_blank" rel="me noopener noreferrer">
                <Icon class="h-5 w-5" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Words rise in one by one once the section is on screen. */
  .word {
    display: inline-block;
    white-space: pre;
  }
  :global(.js) .intro:not(.is-in) .word,
  :global(.js) .intro:not(.is-in) .fade-up,
  :global(.js) .intro:not(.is-in) .cap {
    opacity: 0;
    transform: translateY(0.6em);
  }
  .word,
  .fade-up,
  .cap {
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .word {
    transition-delay: calc(var(--i) * 45ms);
  }
  .cap {
    transition-delay: 0.8s;
  }
  .fade-up {
    transition-delay: 1s;
  }
  .cap-line {
    display: inline-block;
    width: 2rem;
    height: 1px;
    margin-right: 0.6rem;
    vertical-align: middle;
    background: var(--accent);
  }

  .hero {
    background: radial-gradient(
      60% 70% at 85% 40%,
      color-mix(in srgb, var(--accent) 12%, transparent),
      transparent 70%
    );
  }
  .hero-title > span {
    animation: title-in 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero-title > span:nth-child(2) {
    animation-delay: 90ms;
  }
  .hero-title > span:nth-child(3) {
    animation-delay: 180ms;
  }
  @keyframes title-in {
    from {
      opacity: 0;
      transform: translateY(0.4em);
    }
  }
  .social {
    position: relative;
    z-index: 3;
    display: inline-flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.8rem;
    color: var(--fg-muted);
    transition:
      color 200ms ease,
      background-color 200ms ease,
      transform 200ms ease;
  }
  .social:hover {
    color: var(--primary);
    background: var(--bg-alt);
    transform: translateY(-2px);
  }
  .blob {
    pointer-events: none;
    position: absolute;
    border-radius: 9999px;
    filter: blur(40px);
    opacity: 0.55;
  }
  .blob-a {
    width: 60%;
    aspect-ratio: 1;
    left: -10%;
    top: -10%;
    background: var(--accent);
    animation: drift-a 14s ease-in-out infinite;
  }
  .blob-b {
    width: 55%;
    aspect-ratio: 1;
    right: -15%;
    bottom: -15%;
    background: var(--primary);
    opacity: 0.35;
    animation: drift-b 18s ease-in-out infinite;
  }
  @keyframes drift-a {
    50% {
      transform: translate(18%, 22%) scale(1.15);
    }
  }
  @keyframes drift-b {
    50% {
      transform: translate(-20%, -18%) scale(1.1);
    }
  }
  .lines {
    pointer-events: none;
    position: absolute;
    left: -25%;
    top: -15%;
    width: 150%;
    height: 130%;
    overflow: visible;
  }
  .lines path {
    fill: none;
    stroke: color-mix(in srgb, var(--fg) 25%, transparent);
    stroke-width: 1.2;
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    transition: stroke-dashoffset 2.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .lines path:nth-child(2) {
    transition-delay: 0.3s;
  }
  .lines path:nth-child(3) {
    transition-delay: 0.6s;
  }
  .intro.is-in .lines path {
    stroke-dashoffset: 0;
  }
  .frame {
    position: absolute;
    inset: 0;
    transform: perspective(900px) rotateX(calc(var(--py, 0) * -6deg)) rotateY(calc(var(--px, 0) * 8deg));
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
    overflow: hidden;
    border-radius: 1.5rem;
    box-shadow: 0 30px 60px -25px rgb(0 0 0 / 0.5);
  }
  .frame img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transform: scale(1.12);
    transition: transform 1.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .intro.is-in .frame img {
    transform: scale(1);
  }
  .chip-float {
    position: absolute;
    z-index: 2;
    /* Pointer parallax rides on the independent `translate` property so it
       composes with the floating keyframes on `transform`. */
    translate: calc(var(--px, 0) * var(--depth, -18px)) calc(var(--py, 0) * var(--depth, -18px));
    transition: translate 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 0.45rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--fg);
    box-shadow: var(--shadow-card);
    animation: float-chip 6s ease-in-out infinite;
    white-space: nowrap;
  }
  .chip-float:hover {
    color: var(--primary);
  }
  .chip-1 {
    left: -18%;
    top: 9%;
  }
  .chip-2 {
    --depth: 26px;
    right: -16%;
    top: 46%;
    animation-delay: -2s;
  }
  .chip-3 {
    --depth: -30px;
    left: -14%;
    bottom: 22%;
    animation-delay: -4s;
  }
  .chip-4 {
    --depth: 20px;
    right: -10%;
    top: -4%;
    animation-delay: -1s;
  }
  .chip-5 {
    --depth: -24px;
    right: -6%;
    bottom: -3%;
    animation-delay: -3s;
  }
  @keyframes float-chip {
    50% {
      transform: translateY(-10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blob,
    .chip-float,
    .hero-title > span {
      animation: none;
    }
  }
</style>

<script>
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  if (intro) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          intro.classList.add('is-in');
          io.disconnect();
        }
      },
      { threshold: 0.25 },
    );
    io.observe(intro);

    // Pointer parallax on the portrait panel: photo tilts, chips drift.
    const panel = intro.querySelector<HTMLElement>('.portrait');
    if (panel && matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      intro.addEventListener('pointermove', (e) => {
        const r = panel.getBoundingClientRect();
        panel.style.setProperty('--px', ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
        panel.style.setProperty('--py', ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
      });
      intro.addEventListener('pointerleave', () => {
        panel.style.setProperty('--px', '0');
        panel.style.setProperty('--py', '0');
      });
    }
  }
</script>
