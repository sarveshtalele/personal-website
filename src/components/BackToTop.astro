---
import { ArrowUp } from '@lucide/astro';
---

<a href="#main" class="to-top" aria-label="Back to top" data-to-top>
  <svg class="progress-ring" viewBox="0 0 48 48" aria-hidden="true">
    <circle cx="24" cy="24" r="21" class="track"></circle>
    <circle cx="24" cy="24" r="21" class="bar" pathLength="1"></circle>
  </svg>
  <ArrowUp class="relative h-4 w-4" aria-hidden="true" />
</a>

<style>
  .to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: grid;
    place-items: center;
    height: 3rem;
    width: 3rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--card) 90%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-card-hover);
    color: var(--fg);
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition:
      opacity 300ms ease,
      transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .to-top.is-shown {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .to-top:hover {
    color: var(--primary);
  }
  .progress-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    rotate: -90deg;
  }
  .track,
  .bar {
    fill: none;
    stroke-width: 2.5;
  }
  .track {
    stroke: var(--border);
  }
  .bar {
    stroke: var(--primary);
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--scroll, 0));
  }
</style>

<script>
  const btn = document.querySelector<HTMLElement>('[data-to-top]');
  if (btn) {
    const update = () => btn.classList.toggle('is-shown', scrollY > 600);
    addEventListener('scroll', update, { passive: true });
    update();
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  }
</script>
