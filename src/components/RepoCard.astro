---
import { Star, GitFork, Pin, ExternalLink } from '@lucide/astro';
import GithubIcon from './icons/GithubIcon.astro';
import type { Repo } from '@lib/github';
import { LANGUAGE_COLORS } from '@lib/github';

interface Props {
  repo: Repo;
  categoryLabels: Record<string, string>;
}
const { repo, categoryLabels } = Astro.props;
const updated = new Date(repo.pushedAt || repo.updatedAt);
const updatedLabel = updated.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<article
  class="repo-card card card-hover flex h-full min-w-0 flex-col p-6"
  data-repo
  data-name={repo.name.toLowerCase()}
  data-text={`${repo.name} ${repo.description} ${repo.topics.join(' ')}`.toLowerCase()}
  data-categories={repo.categories.join(',')}
  data-language={repo.language ?? ''}
  data-stars={repo.stars}
  data-forks={repo.forks}
  data-updated={updated.getTime()}
  data-pinned={repo.pinned ? 'true' : 'false'}
  data-pin-order={repo.pinOrder}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="min-w-0 break-words font-display text-[1.45rem] font-semibold leading-tight text-fg">
      <a
        href={repo.url}
        target="_blank"
        rel="noopener noreferrer"
        class="repo-title hover:text-primary after:absolute after:inset-0 after:content-['']"
      >
        {repo.name.replace(/[-_]/g, ' ')}
      </a>
    </h3>
    {
      repo.pinned && (
        <span class="chip chip-gold shrink-0" title="Pinned">
          <Pin class="h-3 w-3" aria-hidden="true" /> Pinned
        </span>
      )
    }
  </div>
  <p class="mt-1 break-all font-mono text-[0.7rem] text-fg-faint">sarveshtalele/{repo.name}</p>
  <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-fg-muted">{repo.description}</p>

  {
    repo.categories.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {repo.categories.map((c) => (
          <span class="chip">{categoryLabels[c] ?? c}</span>
        ))}
      </div>
    )
  }

  <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-4 text-xs text-fg-muted">
    {
      repo.language && (
        <span class="inline-flex items-center gap-1.5">
          <span
            class="h-2.5 w-2.5 rounded-full"
            style={`background:${LANGUAGE_COLORS[repo.language] ?? 'var(--accent)'}`}
          />
          {repo.language}
        </span>
      )
    }
    <span class="inline-flex items-center gap-1" title={`${repo.stars} stars`}>
      <Star class="h-3.5 w-3.5 text-accent" aria-hidden="true" />{repo.stars}
    </span>
    <span class="inline-flex items-center gap-1" title={`${repo.forks} forks`}>
      <GitFork class="h-3.5 w-3.5 text-accent" aria-hidden="true" />{repo.forks}
    </span>
    <span class="ml-auto text-fg-faint">Updated {updatedLabel}</span>
  </div>

  <div class="relative z-10 mt-4 flex flex-wrap gap-2">
    <a href={repo.url} target="_blank" rel="noopener noreferrer" class="repo-action">
      <GithubIcon class="h-3.5 w-3.5" /> Source
    </a>
    {
      repo.homepage && (
        <a href={repo.homepage} target="_blank" rel="noopener noreferrer" class="repo-action">
          <ExternalLink class="h-3.5 w-3.5" aria-hidden="true" /> Live
        </a>
      )
    }
  </div>
</article>
