---
import { getProfile } from '@lib/content';
const { data: profile } = await getProfile();
---

<section class="interlude relative py-24 sm:py-32" aria-label="Quotes I live by">
  <div class="mx-auto max-w-4xl px-4 text-center sm:px-6" data-quotes>
    <p class="font-display text-7xl leading-none text-accent/60" aria-hidden="true">“</p>
    <div class="quote-stage">
      {
        profile.quotes.map((q, i) => (
          <figure class:list={['quote', i === 0 && 'is-active']} aria-hidden={i === 0 ? undefined : 'true'}>
            <blockquote class="font-display text-[clamp(1.8rem,4.4vw,3.2rem)] font-medium italic leading-[1.2] text-fg">
              {q.text}
            </blockquote>
            <figcaption class="mt-6 text-xs uppercase tracking-[0.3em] text-fg-faint">
              {q.author}
              {q.source && <span class="text-accent"> · {q.source}</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>
    {
      profile.quotes.length > 1 && (
        <div class="mt-8 flex justify-center gap-2">
          {profile.quotes.map((_, i) => (
            <button
              type="button"
              class:list={['dot', i === 0 && 'is-active']}
              data-dot={i}
              aria-label={`Show quote ${i + 1}`}
            />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .interlude::before {
    content: '';
    position: absolute;
    inset: 10% 0;
    z-index: -1;
    background: radial-gradient(
      50% 60% at 50% 50%,
      color-mix(in srgb, var(--accent) 12%, transparent),
      transparent 70%
    );
  }
  .quote-stage {
    display: grid;
  }
  .quote {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(12px);
    filter: blur(6px);
    transition:
      opacity 900ms ease,
      transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 900ms ease;
    pointer-events: none;
  }
  .quote.is-active {
    opacity: 1;
    transform: none;
    filter: none;
    pointer-events: auto;
  }
  .dot {
    height: 6px;
    width: 6px;
    border-radius: 9999px;
    background: var(--border-strong);
    transition: all 400ms ease;
  }
  .dot.is-active {
    width: 28px;
    background: var(--accent);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-quotes]').forEach((root) => {
    const quotes = [...root.querySelectorAll<HTMLElement>('.quote')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    if (quotes.length < 2) return;
    let i = 0;
    const show = (n: number) => {
      i = n;
      quotes.forEach((q, k) => {
        q.classList.toggle('is-active', k === n);
        q.toggleAttribute('aria-hidden', k !== n);
      });
      dots.forEach((d, k) => d.classList.toggle('is-active', k === n));
    };
    dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.dot))));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => show((i + 1) % quotes.length), 7000);
  });
</script>
