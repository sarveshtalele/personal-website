---
/** Speaker switch for the optional soundtrack. Sound is always off until tapped. */
import { Volume2, VolumeX } from '@lucide/astro';
---

<button
  id="sound-toggle"
  type="button"
  class="sound-btn inline-flex h-9 items-center justify-center gap-1.5 rounded-xl px-2 text-fg-muted transition-colors hover:bg-bg-alt hover:text-fg"
  aria-pressed="false"
  aria-label="Sound off. Turn on the soundtrack"
  title="Soundtrack"
>
  <VolumeX class="snd-off h-[18px] w-[18px]" aria-hidden="true" />
  <Volume2 class="snd-on h-[18px] w-[18px]" aria-hidden="true" />
  <span class="snd-bars" aria-hidden="true"><i></i><i></i><i></i></span>
</button>

<style>
  .snd-on,
  .snd-bars,
  .sound-btn[aria-pressed='true'] .snd-off {
    display: none;
  }
  .sound-btn[aria-pressed='true'] .snd-on {
    display: block;
  }
  .sound-btn[aria-pressed='true'] {
    color: var(--primary);
  }
  .sound-btn[aria-pressed='true'] .snd-bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }
  .snd-bars i {
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: currentColor;
    transform-origin: bottom;
    animation: eq 1.1s ease-in-out infinite;
  }
  .snd-bars i:nth-child(2) {
    animation-delay: -0.35s;
  }
  .snd-bars i:nth-child(3) {
    animation-delay: -0.7s;
  }
  @keyframes eq {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .snd-bars i {
      animation: none;
      transform: scaleY(0.7);
    }
  }
</style>

<script>
  const btn = document.getElementById('sound-toggle');
  let mod: typeof import('../scripts/sound') | null = null;
  const set = async (on: boolean) => {
    btn?.setAttribute('aria-pressed', String(on));
    btn?.setAttribute('aria-label', on ? 'Sound on. Turn off the soundtrack' : 'Sound off. Turn on the soundtrack');
    try {
      localStorage.setItem('sound', on ? 'on' : 'off');
    } catch {
      /* storage blocked */
    }
    if (on && !mod) mod = await import('../scripts/sound');
    await mod?.setSound(on);
  };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-pressed') !== 'true'));
  document.addEventListener('voyage:sound-request', () => set(true));

  // Browsers only allow audio after a gesture. If the reader turned sound on
  // before, resume it on their first tap or key press, never on load.
  let wanted = false;
  try {
    wanted = localStorage.getItem('sound') === 'on';
  } catch {
    /* storage blocked */
  }
  if (wanted) {
    const resume = () => set(true);
    addEventListener('pointerdown', resume, { once: true });
    addEventListener('keydown', resume, { once: true });
  }
</script>
