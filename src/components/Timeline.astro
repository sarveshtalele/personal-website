---
import type { CollectionEntry } from 'astro:content';
import { formatMonthYear } from '@utils/format';

interface Props {
  entries: CollectionEntry<'experience'>[];
  /** Max highlights to show per entry (0 = all) */
  maxHighlights?: number;
}
const { entries, maxHighlights = 0 } = Astro.props;
---

<ol class="timeline relative space-y-10 pl-8">
  {
    entries.map((entry, i) => {
      const { company, role, location, startDate, endDate, current, highlights, companyUrl } = entry.data;
      const shown = maxHighlights > 0 ? highlights.slice(0, maxHighlights) : highlights;
      return (
        <li class:list={['relative', `reveal-i-${Math.min(i + 1, 5)}`]} data-reveal>
          <span class:list={['node', current && 'node-current']} aria-hidden="true" />
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">
            <time datetime={startDate.toISOString()}>{formatMonthYear(startDate)}</time>
            {' – '}
            {current || !endDate ? 'Present' : <time datetime={endDate.toISOString()}>{formatMonthYear(endDate)}</time>}
          </p>
          <h3 class="mt-2 font-display text-2xl font-semibold leading-tight text-fg">{role}</h3>
          <p class="mt-1 text-sm text-fg-muted">
            {companyUrl ? (
              <a href={companyUrl} target="_blank" rel="noopener noreferrer" class="hover:text-primary">
                {company}
              </a>
            ) : (
              company
            )}
            {location && <span class="text-fg-faint"> · {location}</span>}
          </p>
          {shown.length > 0 && (
            <ul class="mt-4 space-y-2 text-sm leading-relaxed text-fg-muted">
              {shown.map((h) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rotate-45 bg-accent" aria-hidden="true" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 1px;
    background: linear-gradient(180deg, var(--accent), var(--border) 60%, transparent);
  }
  .node {
    position: absolute;
    left: -2rem;
    top: 0.2rem;
    height: 0.95rem;
    width: 0.95rem;
    border-radius: 9999px;
    border: 2px solid var(--accent);
    background: var(--bg);
  }
  .node-current {
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--glow);
  }
</style>
