---
import BaseLayout from './BaseLayout.astro';
import Container from '@components/Container.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  crumbs?: Crumb[];
  image?: string;
  /** Hide the large page header (for pages that render their own hero). */
  bare?: boolean;
}
const { title, description, eyebrow, crumbs, image, bare = false } = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
  <Container class="py-10 sm:py-14">
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    {
      !bare && (
        <header class="page-head max-w-3xl">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h1 class="mt-4 font-display text-5xl font-semibold leading-[1.02] tracking-tight text-fg sm:text-6xl">
            {title}
          </h1>
          <p class="mt-5 text-lg text-fg-muted">{description}</p>
        </header>
      )
    }
    <div class:list={[!bare && 'mt-12']}>
      <slot />
    </div>
  </Container>
</BaseLayout>

<style>
  .page-head > * {
    animation: head-in 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .page-head > *:nth-child(2) {
    animation-delay: 80ms;
  }
  .page-head > *:nth-child(3) {
    animation-delay: 160ms;
  }
  @keyframes head-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
