---
import BaseHead from '@components/BaseHead.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary"
    >
      Skip to content
    </a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Navbar />
    <main id="main" class="flex-1" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .scroll-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 70;
    transform-origin: 0 50%;
    transform: scaleX(var(--scroll, 0));
    background: linear-gradient(90deg, var(--gold-2), var(--gold-1), var(--primary));
    pointer-events: none;
  }
</style>

<script>
  // Scroll-reveal for any element marked data-reveal, plus a thin reading
  // progress bar. Both are progressive enhancements: without JS the page is
  // fully visible (the `.js` class gate lives in global.css).
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

  const root = document.documentElement;
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const max = root.scrollHeight - root.clientHeight;
      root.style.setProperty('--scroll', String(max > 0 ? root.scrollTop / max : 0));
      ticking = false;
    });
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Count-up for any [data-count] element: animates the first number in its
  // text ("50K+", "4+ yrs", "Top 15") once it scrolls into view.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counter = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        counter.unobserve(e.target);
        const el = e.target as HTMLElement;
        const text = el.textContent ?? '';
        const m = text.match(/\d[\d,.]*/);
        if (!m || reduce) continue;
        const target = Number(m[0].replace(/,/g, ''));
        const decimals = (m[0].split('.')[1] ?? '').length;
        const t0 = performance.now();
        const tick = (now: number) => {
          const k = Math.min((now - t0) / 1400, 1);
          const v = (target * (1 - Math.pow(1 - k, 3))).toFixed(decimals);
          el.textContent = text.replace(m[0], k < 1 ? v : m[0]);
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    },
    { threshold: 0.5 },
  );
  document.querySelectorAll('[data-count]').forEach((el) => counter.observe(el));
</script>
