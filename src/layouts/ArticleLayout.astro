---
import type { MarkdownHeading, ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Container from '@components/Container.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TableOfContents from '@components/TableOfContents.astro';
import ShareButtons from '@components/ShareButtons.astro';
import Tag from '@components/Tag.astro';
import Giscus from '@components/Giscus.astro';
import { formatDate, slugifyTag } from '@utils/format';
import { getProfile } from '@lib/content';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  minutesRead?: number;
  tags?: string[];
  category?: string;
  heroImage?: ImageMetadata;
  heroAlt?: string;
  headings: MarkdownHeading[];
  crumbs: Crumb[];
  /** Where the post was first published (shown as a note, canonical stays on this site). */
  originalUrl?: string;
  showShare?: boolean;
  showComments?: boolean;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  minutesRead,
  tags = [],
  category,
  heroImage,
  heroAlt = '',
  headings,
  crumbs,
  originalUrl,
  showShare = false,
  showComments = false,
} = Astro.props;

const { data: profile } = await getProfile();
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const originHost = originalUrl ? new URL(originalUrl).hostname.replace(/^www\./, '') : '';
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage?.src}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
>
  <Container size="wide" class="py-10 sm:py-14">
    <Breadcrumbs crumbs={crumbs} />
    <header class="article-head mx-auto max-w-3xl text-center">
      {category && <p class="eyebrow justify-center">{category}</p>}
      <h1
        class="mt-5 font-display text-[clamp(2.4rem,6vw,4.25rem)] font-semibold leading-[1.02] tracking-tight text-fg"
      >
        {title}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-fg-muted">{description}</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm text-fg-faint">
        <img src={profile.photo} alt="" width="28" height="28" class="h-7 w-7 rounded-full object-cover" />
        <span class="font-medium text-fg-muted">{profile.name}</span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>· Updated {formatDate(updatedDate)}</span>}
        {minutesRead && <span>· {minutesRead} min read</span>}
      </div>
      {
        tags.length > 0 && (
          <div class="mt-5 flex flex-wrap justify-center gap-2">
            {tags.map((tag) => (
              <Tag tag={`#${tag}`} href={`/blog/tags/${slugifyTag(tag)}`} linked />
            ))}
          </div>
        )
      }
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroAlt}
          widths={[640, 1024, 1400]}
          sizes="(min-width: 1024px) 1000px, 100vw"
          loading="eager"
          class="mx-auto mt-10 w-full max-w-5xl rounded-2xl border border-line object-cover shadow-xl"
        />
      )
    }

    <div class="mx-auto mt-12 grid max-w-6xl gap-12 lg:grid-cols-[minmax(0,1fr)_14rem]">
      <article class="min-w-0">
        {
          originHost && (
            <p class="mb-8 rounded-xl border border-line bg-surface px-4 py-3 text-sm text-fg-muted">
              Originally published on{' '}
              <a
                href={originalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-primary underline underline-offset-2"
              >
                {originHost}
              </a>
              .
            </p>
          )
        }
        <div class="prose">
          <slot />
        </div>
        {
          showShare && (
            <div class="mt-12 border-t border-line pt-6">
              <ShareButtons title={title} url={canonicalURL} />
            </div>
          )
        }
        <slot name="after" />
        {showComments && <Giscus />}
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </Container>
</BaseLayout>

<style>
  .article-head > * {
    animation: head-in 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .article-head > *:nth-child(2) {
    animation-delay: 80ms;
  }
  .article-head > *:nth-child(3) {
    animation-delay: 160ms;
  }
  .article-head > *:nth-child(4) {
    animation-delay: 240ms;
  }
  @keyframes head-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
