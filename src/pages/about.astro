---
import { render } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Button from '@components/Button.astro';
import SkillsBento from '@components/SkillsBento.astro';
import CredentialWall from '@components/CredentialWall.astro';
import VerifiedBadges from '@components/VerifiedBadges.astro';
import { GraduationCap, Trophy, ArrowRight } from '@lucide/astro';
import { getProfile } from '@lib/content';

const profile = await getProfile();
const { Content } = await render(profile);
const p = profile.data;
---

<PageLayout title="About" description={p.tagline} eyebrow="About me" crumbs={[{ label: 'About' }]}>
  <div class="grid gap-12 lg:grid-cols-[18rem_minmax(0,1fr)]">
    <div class="lg:sticky lg:top-24 lg:self-start" data-reveal>
      <div class="about-arch mx-auto w-56 lg:w-full">
        <img src={p.photo} alt={p.fullName} width="320" height="400" class="h-full w-full object-cover" />
      </div>
      <p class="mt-6 text-center font-display text-2xl font-semibold text-fg lg:text-left">{p.fullName}</p>
      <p class="mt-1 text-center text-sm text-fg-muted lg:text-left">{p.role}</p>
      <p class="mt-1 text-center text-xs text-fg-faint lg:text-left">{p.location}</p>
      <div class="mt-5 flex flex-wrap justify-center gap-2 lg:justify-start">
        <Button href="/contact" size="md">Get in touch <ArrowRight class="h-4 w-4" aria-hidden="true" /></Button>
        <Button href="/dashboard" variant="secondary">Dashboard</Button>
      </div>
    </div>

    <div class="min-w-0">
      <div class="prose" data-reveal>
        <Content />
      </div>

      <div class="mt-12" data-reveal>
        <p class="eyebrow mb-4">Verified profiles</p>
        <VerifiedBadges />
      </div>
    </div>
  </div>

  <h2 class="mb-6 mt-20 font-display text-4xl font-semibold text-fg" data-reveal>Skills</h2>
  <SkillsBento />

  <h2 class="mb-6 mt-20 font-display text-4xl font-semibold text-fg" data-reveal>Credentials</h2>
  <CredentialWall />

  <div class="mt-20 grid gap-6 lg:grid-cols-2">
    <div class="card p-6 sm:p-8" data-reveal>
      <p class="flex items-center gap-2 font-display text-2xl font-semibold text-fg">
        <GraduationCap class="h-5 w-5 text-accent" aria-hidden="true" /> Education
      </p>
      <div class="mt-5 space-y-5">
        {
          p.education.map((e) => (
            <div>
              <p class="font-semibold text-fg">{e.degree}</p>
              <p class="text-sm text-fg-muted">{e.institution}</p>
              <p class="text-xs text-fg-faint">
                {e.year} · {e.detail}
              </p>
            </div>
          ))
        }
      </div>
    </div>
    <div id="achievements" class="card scroll-mt-24 p-6 sm:p-8" data-reveal>
      <p class="flex items-center gap-2 font-display text-2xl font-semibold text-fg">
        <Trophy class="h-5 w-5 text-accent" aria-hidden="true" /> Achievements
      </p>
      <ul class="mt-5 space-y-3">
        {
          p.achievements.map((a) => (
            <li class="flex gap-3 text-sm text-fg-muted">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rotate-45 bg-accent" aria-hidden="true" />
              {a.href ? (
                <a
                  href={a.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-accent/40 underline-offset-2 hover:text-primary"
                >
                  {a.text}
                </a>
              ) : (
                <span>{a.text}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</PageLayout>

<style>
  .about-arch {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 999px 999px 1.25rem 1.25rem;
    padding: 5px;
    background: linear-gradient(160deg, var(--gold-1), var(--gold-2));
  }
  .about-arch img {
    border-radius: inherit;
  }
</style>
