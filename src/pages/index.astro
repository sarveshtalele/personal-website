---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import IntroHero from '@components/IntroHero.astro';
import SkillsMarquee from '@components/SkillsMarquee.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import ImpactGrid from '@components/ImpactGrid.astro';
import RepoCard from '@components/RepoCard.astro';
import BlogCard from '@components/BlogCard.astro';
import Timeline from '@components/Timeline.astro';
import TopmateCTA from '@components/TopmateCTA.astro';
import { GraduationCap, BookOpen } from '@lucide/astro';
import { getProfile, getPosts, getProjectSettings } from '@lib/content';
import { getGithubStats } from '@lib/github';
import { minutesRead } from '@lib/blog';
import { byDateDesc } from '@utils/format';
import claudeStats from '../data/claude-stats.json';

const { data: profile } = await getProfile();
const settings = await getProjectSettings();
const gh = await getGithubStats();
const posts = (await getPosts()).slice(0, 3);
const minutes = Object.fromEntries(await Promise.all(posts.map(async (p) => [p.id, await minutesRead(p)] as const)));
const experience = (await getCollection('experience')).sort(byDateDesc((e) => e.data.startDate));
const claudeCerts = (await getCollection('certifications'))
  .filter((c) => c.data.featured && c.data.badge)
  .sort(byDateDesc((c) => c.data.date));
---

<BaseLayout title="Sarvesh Talele">
  <IntroHero />
  <SkillsMarquee />

  <section id="proof" class="border-y border-line py-8" aria-label="Credentials">
    <ul class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-2 px-4 sm:px-6">
      {
        profile.credentials.map((c) => (
          <li>
            <a
              href={c.href}
              class="chip transition-colors hover:border-accent hover:text-primary"
              {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Container>
    <Section
      eyebrow="Evidence"
      title="Impact, with receipts"
      description="Every number links to where it can be verified."
      href="/dashboard"
      linkLabel="Full dashboard"
    >
      <ImpactGrid />
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4" data-reveal>
        <a href={gh.profileUrl} target="_blank" rel="noopener noreferrer" class="mini-stat card card-hover p-4">
          <span class="font-display text-3xl font-semibold text-fg" data-count>{gh.stars}</span>
          <span class="text-xs text-fg-muted">GitHub stars</span>
        </a>
        <a href={gh.profileUrl} target="_blank" rel="noopener noreferrer" class="mini-stat card card-hover p-4">
          <span class="font-display text-3xl font-semibold text-fg" data-count>{gh.forks}</span>
          <span class="text-xs text-fg-muted">Forks by others</span>
        </a>
        <a href="/projects" class="mini-stat card card-hover p-4">
          <span class="font-display text-3xl font-semibold text-fg" data-count>{gh.publicRepos}</span>
          <span class="text-xs text-fg-muted">Public repositories</span>
        </a>
        <a href="/claude/review" class="mini-stat card card-hover p-4">
          <span class="font-display text-3xl font-semibold text-fg" data-count>{claudeStats.total}</span>
          <span class="text-xs text-fg-muted">Free exam questions written</span>
        </a>
      </div>
    </Section>
  </Container>

  <Container>
    <Section
      eyebrow="Selected work"
      title="Pinned projects"
      description="Hand-picked from GitHub. Stars and forks sync on every deploy."
      href="/projects"
      linkLabel="All projects"
    >
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          gh.pinned.slice(0, 6).map((repo, i) => (
            <div data-reveal class={`reveal-i-${(i % 3) + 1}`}>
              <RepoCard repo={repo} categoryLabels={settings.categories} />
            </div>
          ))
        }
      </div>
    </Section>

    {
      posts.length > 0 && (
        <Section eyebrow="Writing" title="From the journal" href="/blog" linkLabel="All posts">
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((p, i) => (
              <div data-reveal class:list={[`reveal-i-${i + 1}`, posts.length === 1 && 'sm:col-span-2 lg:col-span-3']}>
                <BlogCard post={p} minutes={minutes[p.id]} featured={posts.length === 1} />
              </div>
            ))}
          </div>
        </Section>
      )
    }

    <Section
      eyebrow="Claude Prep"
      title="Certified twice. Teaching it for free."
      href="/claude"
      linkLabel="Open Claude Prep"
    >
      <div class="card grid gap-8 overflow-hidden p-6 sm:p-10 lg:grid-cols-[1fr_1.2fr] lg:items-center" data-reveal>
        <div class="flex items-center justify-center gap-4 sm:gap-8">
          {
            claudeCerts.map((c) => (
              <a href={c.data.credentialUrl} target="_blank" rel="noopener noreferrer" class="group text-center">
                <img
                  src={c.data.badge}
                  alt={`${c.data.title} badge, verify on Credly`}
                  width="150"
                  height="150"
                  loading="lazy"
                  class="mx-auto h-28 w-28 object-contain drop-shadow-xl transition-transform duration-500 group-hover:-translate-y-1 group-hover:rotate-2 sm:h-36 sm:w-36"
                />
                <span class="mt-2 block text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-accent">
                  Verify ↗
                </span>
              </a>
            ))
          }
        </div>
        <div>
          <p class="text-fg-muted">
            I hold both Anthropic credentials and wrote a free prep library for the Foundations exam:{' '}
            <strong class="text-fg">{claudeStats.total} scenario questions</strong> across {claudeStats.domains} domains and{
              ' '
            }
            {claudeStats.tasks} task statements, each with an explanation and the official doc to read, plus a timed {
              claudeStats.mock
            }-question mock exam.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/claude/quiz"
              class="btn-primary relative inline-flex items-center gap-2 overflow-hidden rounded-full px-5 py-2.5 text-sm font-medium transition-all hover:-translate-y-0.5"
            >
              <GraduationCap class="h-4 w-4" aria-hidden="true" /> Take the mock exam
            </a>
            <a
              href="/claude/review"
              class="inline-flex items-center gap-2 rounded-full border border-line-strong px-5 py-2.5 text-sm font-medium text-fg transition-all hover:-translate-y-0.5 hover:border-accent"
            >
              <BookOpen class="h-4 w-4" aria-hidden="true" /> Study all {claudeStats.total}
            </a>
          </div>
        </div>
      </div>
    </Section>

    <Section eyebrow="Journey" title="Where I've built" href="/experience" linkLabel="Full history">
      <div data-reveal>
        <Timeline entries={experience.slice(0, 3)} maxHighlights={2} />
      </div>
    </Section>

    <section class="pb-8 pt-8">
      <TopmateCTA />
    </section>
  </Container>
</BaseLayout>

<style>
  .mini-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
</style>
