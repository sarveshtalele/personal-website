---
import { getEntry } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import FollowLinkedIn from '@components/FollowLinkedIn.astro';
import PodcastCard from '@components/PodcastCard.astro';
import { getAppearances } from '@lib/content';
import { ArrowUpRight, Search } from '@lucide/astro';
import { formatDate, slugifyTag } from '@utils/format';

const entry = await getEntry('references', 'links');
if (!entry) throw new Error('Missing content/references/links.md');
const { title, intro, items } = entry.data;
const sorted = [...items].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const sources = [...new Set(sorted.map((i) => i.source))].sort();
const topics = [...new Set(sorted.flatMap((i) => i.topics))].sort();
const appearances = await getAppearances();
const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
---

<PageLayout title={title} description={intro} eyebrow="Elsewhere" crumbs={[{ label: title }]}>
  {
    appearances.length > 0 && (
      <section class="mb-14" aria-labelledby="pods">
        <h2 id="pods" class="mb-5 text-2xl font-bold tracking-tight text-fg">
          Podcasts & talks
        </h2>
        <div class="grid gap-6">
          {appearances.map((a) => (
            <PodcastCard item={a} wide />
          ))}
        </div>
      </section>
    )
  }
  <h2 class="mb-5 text-2xl font-bold tracking-tight text-fg">Posts & articles</h2>
  <div data-refs>
    <div class="card mb-8 flex flex-col gap-4 p-4 sm:p-5">
      <label class="relative block">
        <span class="sr-only">Search references</span>
        <Search
          class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-fg-faint"
          aria-hidden="true"
        />
        <input type="search" class="field h-11 pl-9" placeholder="Search titles and notes…" data-q autocomplete="off" />
      </label>
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by source">
        <span class="mr-1 text-xs font-semibold text-fg-faint">Source</span>
        <button type="button" class="pill" data-source="" aria-pressed="true">All</button>
        {
          sources.map((s) => (
            <button type="button" class="pill" data-source={s} aria-pressed="false">
              {s}
            </button>
          ))
        }
      </div>
      {
        topics.length > 0 && (
          <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by topic">
            <span class="mr-1 text-xs font-semibold text-fg-faint">Topic</span>
            <button type="button" class="pill" data-topic="" aria-pressed="true">
              All
            </button>
            {topics.map((t) => (
              <button type="button" class="pill" data-topic={slugifyTag(t)} aria-pressed="false">
                {t}
              </button>
            ))}
          </div>
        )
      }
      <p class="text-xs text-fg-faint" data-count aria-live="polite">{sorted.length} references</p>
    </div>

    <ul class="grid gap-4 md:grid-cols-2">
      {
        sorted.map((r, i) => (
          <li
            data-ref
            data-source={r.source}
            data-topics={r.topics.map(slugifyTag).join(',')}
            data-text={`${r.title} ${r.note} ${r.source}`.toLowerCase()}
            class={`reveal-i-${(i % 2) + 1}`}
            data-reveal
          >
            <a
              href={r.url}
              target="_blank"
              rel="noopener noreferrer"
              class="card card-hover group flex h-full flex-col p-6"
            >
              <span class="flex flex-wrap items-center gap-2 text-xs">
                <span class="chip chip-gold">{r.source}</span>
                <time datetime={r.date.toISOString()} class="text-fg-faint">
                  {formatDate(r.date)}
                </time>
              </span>
              <span class="mt-3 text-lg font-bold leading-snug tracking-tight text-fg group-hover:text-primary">
                {r.title}
              </span>
              {r.note && <span class="mt-2 flex-1 text-sm leading-relaxed text-fg-muted">{r.note}</span>}
              <span class="mt-4 flex flex-wrap items-center gap-1.5">
                {r.topics.map((t) => (
                  <span class="chip">{t}</span>
                ))}
                <span class="ml-auto inline-flex items-center gap-1 text-xs font-semibold text-primary">
                  {host(r.url)}
                  <ArrowUpRight
                    class="h-3.5 w-3.5 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                    aria-hidden="true"
                  />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="hidden py-16 text-center text-fg-muted" data-empty>Nothing matches that. Try another filter.</p>
  </div>

  <div
    class="mt-14 flex flex-col items-start gap-4 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="text-fg-muted">Most of my posts start on LinkedIn. Follow along there.</p>
    <FollowLinkedIn showRss={false} />
  </div>
</PageLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-refs]');
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-ref]')];
    const q = root.querySelector<HTMLInputElement>('[data-q]')!;
    const srcBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-source]')].filter(
      (b) => b.tagName === 'BUTTON',
    );
    const topBtns = [...root.querySelectorAll<HTMLButtonElement>('button[data-topic]')];
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    let source = '';
    let topic = '';
    const apply = () => {
      const term = q.value.trim().toLowerCase();
      let shown = 0;
      for (const it of items) {
        const ok =
          (!source || it.dataset.source === source) &&
          (!topic || (it.dataset.topics ?? '').split(',').includes(topic)) &&
          (!term || (it.dataset.text ?? '').includes(term));
        it.hidden = !ok;
        if (ok) shown++;
      }
      srcBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.source ?? '') === source)));
      topBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.topic ?? '') === topic)));
      count.textContent = `${shown} of ${items.length} references`;
      empty.classList.toggle('hidden', shown > 0);
    };
    srcBtns.forEach((b) => b.addEventListener('click', () => ((source = b.dataset.source ?? ''), apply())));
    topBtns.forEach((b) => b.addEventListener('click', () => ((topic = b.dataset.topic ?? ''), apply())));
    q.addEventListener('input', apply);
  }
</script>
