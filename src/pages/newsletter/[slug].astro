---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/Container.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TableOfContents from '@components/TableOfContents.astro';
import ShareButtons from '@components/ShareButtons.astro';
import FollowLinkedIn from '@components/FollowLinkedIn.astro';
import { mdxComponents } from '@components/mdx-components';
import LinkedinIcon from '@components/icons/LinkedinIcon.astro';
import { getIssues, getProfile } from '@lib/content';
import { issueLabel } from '@lib/newsletter';
import { formatDate, slugifyTag } from '@utils/format';

export async function getStaticPaths() {
  const issues = await getIssues();
  return issues.map((issue, i) => ({
    params: { slug: issue.id },
    props: { issue, newer: issues[i - 1], older: issues[i + 1] },
  }));
}

const { issue, newer, older } = Astro.props;
const { data: profile } = await getProfile();
const { Content, headings, remarkPluginFrontmatter } = await render(issue);
const d = issue.data;
const minutes = Number(remarkPluginFrontmatter.minutesRead ?? 1);
const url = new URL(Astro.url.pathname, Astro.site).toString();
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.description}
  image={d.cover?.src}
  type="article"
  pubDate={d.pubDate}
  updatedDate={d.updatedDate}
  tags={d.tags}
>
  <Container size="wide" class="py-10 sm:py-14">
    <Breadcrumbs crumbs={[{ label: 'Newsletter', href: '/newsletter' }, { label: issueLabel(issue.issueNo) }]} />

    <header class="issue-head mx-auto max-w-3xl text-center">
      <p class="eyebrow justify-center">{issueLabel(issue.issueNo)} · {profile.newsletter.name}</p>
      <h1 class="mt-5 text-[clamp(2rem,5vw,3.4rem)] font-bold leading-[1.1] tracking-tight text-fg">{d.title}</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-fg-muted">{d.description}</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm text-fg-faint">
        <img src={profile.photo} alt="" width="32" height="32" class="h-8 w-8 rounded-full object-cover" />
        <span class="font-semibold text-fg-muted">{profile.name}</span>
        <span aria-hidden="true">·</span>
        <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>
        {d.updatedDate && <span>· Updated {formatDate(d.updatedDate)}</span>}
        <span>· {minutes} min read</span>
      </div>
      {
        d.tags.length > 0 && (
          <div class="mt-5 flex flex-wrap justify-center gap-2">
            {d.tags.map((t) => (
              <a href={`/newsletter/topics/${slugifyTag(t)}`} class="chip hover:border-accent hover:text-primary">
                {t}
              </a>
            ))}
          </div>
        )
      }
    </header>

    {
      d.cover && (
        <Image
          src={d.cover}
          alt={d.coverAlt}
          widths={[640, 1024, 1400]}
          sizes="(min-width: 1024px) 1000px, 100vw"
          loading="eager"
          class="mx-auto mt-10 w-full max-w-5xl rounded-2xl border border-line object-cover shadow-xl"
        />
      )
    }

    <div class="mx-auto mt-12 grid max-w-6xl gap-12 lg:grid-cols-[minmax(0,1fr)_15rem]">
      <article class="min-w-0">
        <div class="prose issue-prose mx-auto">
          <Content components={mdxComponents} />
        </div>

        <div class="mx-auto mt-14 max-w-[46rem] space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-4 border-y border-line py-5">
            <ShareButtons title={d.title} url={url} />
            {
              d.linkedin && (
                <a
                  href={d.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
                >
                  <LinkedinIcon class="h-4 w-4" /> Join the discussion on LinkedIn
                </a>
              )
            }
          </div>

          <aside class="card p-6 sm:p-8" aria-label="About this newsletter">
            <div class="flex items-start gap-4">
              <img
                src={profile.photo}
                alt=""
                width="56"
                height="56"
                class="h-14 w-14 shrink-0 rounded-full object-cover"
              />
              <div>
                <p class="text-lg font-bold text-fg">{profile.newsletter.name}</p>
                <p class="mt-1 text-sm leading-relaxed text-fg-muted">{profile.newsletter.about}</p>
              </div>
            </div>
            <div class="mt-5">
              <FollowLinkedIn />
            </div>
          </aside>

          {
            (newer || older) && (
              <nav class="grid gap-4 sm:grid-cols-2" aria-label="More issues">
                {older ? (
                  <a href={`/newsletter/${older.id}`} class="card card-hover p-5">
                    <p class="text-xs font-semibold text-fg-faint">← {issueLabel(older.issueNo)}</p>
                    <p class="mt-1 font-semibold leading-snug text-fg">{older.data.title}</p>
                  </a>
                ) : (
                  <span />
                )}
                {newer && (
                  <a href={`/newsletter/${newer.id}`} class="card card-hover p-5 text-right">
                    <p class="text-xs font-semibold text-fg-faint">{issueLabel(newer.issueNo)} →</p>
                    <p class="mt-1 font-semibold leading-snug text-fg">{newer.data.title}</p>
                  </a>
                )}
              </nav>
            )
          }
          <a href="/newsletter" class="link-arrow text-sm font-medium">← All issues</a>
        </div>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </Container>
</BaseLayout>

<style>
  .issue-prose {
    max-width: 46rem;
    font-size: 1.125rem;
    line-height: 1.85;
  }
  .issue-prose :global(img) {
    width: 100%;
    margin: 1.75rem 0 0.5rem;
    box-shadow: var(--shadow-card);
  }
  .issue-prose :global(h2) {
    padding-top: 0.5rem;
  }
  .issue-head > * {
    animation: head-in 800ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes head-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
