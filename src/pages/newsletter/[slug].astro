---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/Container.astro';
import TableOfContents from '@components/TableOfContents.astro';
import ShareButtons from '@components/ShareButtons.astro';
import FollowLinkedIn from '@components/FollowLinkedIn.astro';
import { mdxComponents } from '@components/mdx-components';
import LinkedinIcon from '@components/icons/LinkedinIcon.astro';
import { getIssues, getProfile } from '@lib/content';
import { minutesRead } from '@lib/newsletter';
import ArticleCard from '@components/newsletter/ArticleCard.astro';
import { ArrowLeft } from '@lucide/astro';
import { formatDate, slugifyTag } from '@utils/format';

export async function getStaticPaths() {
  const issues = await getIssues();
  return issues.map((issue, i) => ({
    params: { slug: issue.id },
    props: { issue, more: issues.filter((x) => x.id !== issue.id).slice(0, 3) },
  }));
}

const { issue, more } = Astro.props;
const { data: profile } = await getProfile();
const { Content, headings, remarkPluginFrontmatter } = await render(issue);
const d = issue.data;
const minutes = Number(remarkPluginFrontmatter.minutesRead ?? 1);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const moreMinutes = Object.fromEntries(await Promise.all(more.map(async (p) => [p.id, await minutesRead(p)] as const)));
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.description}
  image={d.cover?.src}
  type="article"
  pubDate={d.pubDate}
  updatedDate={d.updatedDate}
  tags={d.tags}
>
  <div class="mx-auto w-full max-w-6xl px-4 pt-8 sm:px-6 sm:pt-12">
    <a href="/newsletter" class="pub-link">
      <img src="/images/sarvesh-talele-320.webp" alt="" width="28" height="28" class="h-7 w-7 rounded-full object-cover" />
      {profile.newsletter.name}
    </a>

    <header class="art-head mx-auto mt-10 max-w-[42rem]">
      {
        d.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {d.tags.map((t) => (
              <a href={`/newsletter/archive?topic=${slugifyTag(t)}`} class="tag-link">
                {t}
              </a>
            ))}
          </div>
        )
      }
      <h1 class="mt-4 text-[clamp(2rem,5.2vw,3.1rem)] font-extrabold leading-[1.08] tracking-[-0.025em] text-fg">
        {d.title}
      </h1>
      <p class="subtitle mt-4">{d.description}</p>
      <div class="mt-7 flex flex-wrap items-center justify-between gap-4 border-y border-line py-4">
        <div class="flex items-center gap-3">
          <img src="/images/sarvesh-talele-320.webp" alt="" width="44" height="44" class="h-11 w-11 rounded-full object-cover" />
          <div class="leading-tight">
            <a href="/newsletter/about" class="text-[0.95rem] font-semibold text-fg hover:text-accent">{profile.name}</a>
            <p class="mt-1 text-[0.8rem] text-fg-faint">
              <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>
              {d.updatedDate && <span> · Updated {formatDate(d.updatedDate)}</span>}
              <span> · {minutes} min read</span>
            </p>
          </div>
        </div>
        <ShareButtons title={d.title} url={url} />
      </div>
    </header>

    {
      d.cover && (
        <Image
          src={d.cover}
          alt={d.coverAlt}
          widths={[640, 1024, 1400]}
          sizes="(min-width: 1024px) 896px, 100vw"
          loading="eager"
          class="mx-auto mt-10 w-full max-w-4xl rounded-2xl border border-line object-cover shadow-xl"
        />
      )
    }

    <div class="mx-auto mt-12 grid max-w-6xl gap-12 lg:grid-cols-[1fr_minmax(0,42rem)_1fr]">
      <div class="hidden lg:block" aria-hidden="true"></div>
      <article class="min-w-0">
        <div class="prose issue-prose">
          <Content components={mdxComponents} />
        </div>

        <div class="mt-14 space-y-8">
          <div class="flex flex-wrap items-center justify-between gap-4 border-y border-line py-5">
            <ShareButtons title={d.title} url={url} />
            {
              d.linkedin && (
                <a
                  href={d.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline"
                >
                  <LinkedinIcon class="h-4 w-4" /> Discuss on LinkedIn
                </a>
              )
            }
          </div>

          <aside class="end-card" aria-label="About this newsletter">
            <img src="/images/sarvesh-talele-320.webp" alt="" width="64" height="64" class="h-16 w-16 rounded-full object-cover" />
            <p class="mt-4 text-xl font-bold text-fg">Enjoyed this? There's more where it came from.</p>
            <p class="mt-2 max-w-md text-[0.95rem] leading-relaxed text-fg-muted">{profile.newsletter.about}</p>
            <div class="mt-5 flex flex-wrap items-center justify-center gap-4">
              <FollowLinkedIn />
              <a href="/newsletter/products" class="text-sm font-semibold text-accent hover:underline">Free exam prep &amp; 1:1s</a>
            </div>
          </aside>
        </div>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>

    {
      more.length > 0 && (
        <section class="mx-auto mt-20 max-w-6xl border-t border-line pt-12" aria-labelledby="more-title">
          <h2 id="more-title" class="text-2xl font-bold tracking-tight text-fg">More articles</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {more.map((a) => (
              <ArticleCard article={a} minutes={moreMinutes[a.id]} />
            ))}
          </div>
        </section>
      )
    }
    <a href="/newsletter" class="link-arrow mt-12 text-sm font-semibold">
      <ArrowLeft class="h-4 w-4" aria-hidden="true" /> Back to {profile.newsletter.name}
    </a>
  </div>
</BaseLayout>

<style>
  .pub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--fg);
  }
  .pub-link:hover {
    color: var(--accent);
  }
  .tag-link {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .tag-link:hover {
    text-decoration: underline;
  }
  .subtitle {
    font-family: Charter, 'Bitstream Charter', 'Iowan Old Style', 'Sitka Text', Cambria, Georgia, serif;
    font-size: 1.3rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .issue-prose :global(img) {
    width: 100%;
    margin: 1.75rem 0 0.5rem;
    box-shadow: var(--shadow-card);
  }
  .issue-prose :global(h2) {
    padding-top: 0.5rem;
  }
  .end-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2.25rem 1.5rem;
    border-radius: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .art-head > * {
    animation: head-in 800ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes head-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
