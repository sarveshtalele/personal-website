---
import BaseLayout from '@layouts/BaseLayout.astro';
import NewsletterHero from '@components/newsletter/NewsletterHero.astro';
import NewsletterTabs from '@components/newsletter/NewsletterTabs.astro';
import PathSection from '@components/newsletter/PathSection.astro';
import ArticleCard from '@components/newsletter/ArticleCard.astro';
import FollowLinkedIn from '@components/FollowLinkedIn.astro';
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import { getIssues, getProfile } from '@lib/content';
import { minutesRead, topicIndex } from '@lib/newsletter';
import { slugifyTag } from '@utils/format';

const { data: profile } = await getProfile();
const nl = profile.newsletter;
const articles = await getIssues();
const minutes = Object.fromEntries(await Promise.all(articles.map(async (p) => [p.id, await minutesRead(p)] as const)));
const topics = topicIndex(articles);
const [featured, ...rest] = articles;
const latest = rest.slice(0, 4);
// Shelves only for topics with enough articles to scroll through.
const shelves = topics
  .filter((t) => t.count >= 2)
  .slice(0, 3)
  .map((t) => ({ ...t, items: articles.filter((a) => a.data.tags.some((x) => slugifyTag(x) === t.slug)) }));
---

<BaseLayout title={nl.name} description={nl.tagline}>
  <NewsletterHero />
  <NewsletterTabs active="home" />

  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    {
      !featured ? (
        <p class="text-center text-fg-muted">The first article is on its way.</p>
      ) : (
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1.75fr)_minmax(0,1fr)] lg:gap-12">
          <div data-reveal>
            <ArticleCard article={featured} minutes={minutes[featured.id]} variant="featured" eager />
          </div>
          <aside data-reveal class="reveal-i-2">
            {latest.length > 0 ? (
              <>
                <h2 class="text-2xl font-bold tracking-tight text-fg">Latest articles</h2>
                <div class="mt-6 grid gap-6">
                  {latest.map((a) => (
                    <ArticleCard article={a} minutes={minutes[a.id]} variant="row" />
                  ))}
                </div>
              </>
            ) : (
              <>
                <h2 class="text-2xl font-bold tracking-tight text-fg">What I write about</h2>
                <p class="mt-3 text-fg-muted">{nl.about}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {topics.map((t) => (
                    <a href={`/newsletter/archive?topic=${t.slug}`} class="pill">
                      {t.label}
                    </a>
                  ))}
                </div>
                <div class="mt-6 border-t border-line pt-6">
                  <p class="text-sm text-fg-faint">New articles land here first, then on LinkedIn.</p>
                  <div class="mt-3">
                    <FollowLinkedIn />
                  </div>
                </div>
              </>
            )}
            <a href="/newsletter/archive" class="link-arrow mt-8 text-sm font-semibold">
              Browse the archive <ArrowRight class="h-4 w-4" aria-hidden="true" />
            </a>
          </aside>
        </div>
      )
    }
  </div>

  <PathSection />

  {
    shelves.length > 0 && (
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        {shelves.map((s) => (
          <section class="shelf border-t border-line py-12 first:border-t-0" data-shelf aria-label={s.label}>
            <div class="flex items-end justify-between gap-4">
              <h2 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">{s.label}</h2>
              <div class="flex gap-2">
                <button type="button" class="shelf-btn" data-dir="-1" aria-label={`Previous ${s.label} articles`}>
                  <ArrowLeft class="h-4 w-4" aria-hidden="true" />
                </button>
                <button type="button" class="shelf-btn" data-dir="1" aria-label={`Next ${s.label} articles`}>
                  <ArrowRight class="h-4 w-4" aria-hidden="true" />
                </button>
              </div>
            </div>
            <div class="shelf-track mt-6" data-track>
              {s.items.map((a) => (
                <div class="shelf-item">
                  <ArticleCard article={a} minutes={minutes[a.id]} />
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }

  <div class="mx-auto max-w-6xl px-4 pb-6 pt-14 sm:px-6">
    <div class="flex flex-col items-start justify-between gap-6 border-t border-line pt-10 sm:flex-row sm:items-center">
      <div>
        <p class="text-xl font-bold text-fg">Every article, searchable.</p>
        <p class="mt-1 text-fg-muted">Filter by topic, year, or reading time.</p>
      </div>
      <a
        href="/newsletter/archive"
        class="btn-primary inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold"
      >
        Open the archive <ArrowRight class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .shelf-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(16rem, 85%);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
  }
  @media (min-width: 640px) {
    .shelf-track {
      grid-auto-columns: calc((100% - 1.25rem) / 2);
    }
  }
  @media (min-width: 1024px) {
    .shelf-track {
      grid-auto-columns: calc((100% - 2.5rem) / 3);
    }
  }
  .shelf-item {
    scroll-snap-align: start;
  }
  .shelf-btn {
    display: inline-flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--border-strong);
    color: var(--fg-muted);
    transition: all 200ms ease;
  }
  .shelf-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-shelf]').forEach((shelf) => {
    const track = shelf.querySelector<HTMLElement>('[data-track]')!;
    shelf
      .querySelectorAll<HTMLButtonElement>('[data-dir]')
      .forEach((b) =>
        b.addEventListener('click', () =>
          track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.9, behavior: 'smooth' }),
        ),
      );
  });
</script>
