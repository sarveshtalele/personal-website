---
import PageLayout from '@layouts/PageLayout.astro';
import ArticleCard from '@components/newsletter/ArticleCard.astro';
import FollowLinkedIn from '@components/FollowLinkedIn.astro';
import { getIssues } from '@lib/content';
import { minutesRead, topicIndex } from '@lib/newsletter';
import { slugifyTag } from '@utils/format';

export async function getStaticPaths() {
  const issues = await getIssues();
  return topicIndex(issues).map((t) => ({
    params: { topic: t.slug },
    props: { label: t.label, issues: issues.filter((p) => p.data.tags.some((x) => slugifyTag(x) === t.slug)) },
  }));
}
const { label, issues } = Astro.props;
const minutes = Object.fromEntries(await Promise.all(issues.map(async (p) => [p.id, await minutesRead(p)] as const)));
---

<PageLayout
  title={label}
  description={`${issues.length} article${issues.length === 1 ? '' : 's'} about ${label} in Sarvesh's AI Newsletter.`}
  eyebrow="Newsletter topic"
  crumbs={[{ label: 'Newsletter', href: '/newsletter' }, { label }]}
>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {issues.map((p) => <ArticleCard article={p} minutes={minutes[p.id]} />)}
  </div>
  <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-8">
    <a href="/newsletter/archive" class="link-arrow text-sm font-medium">← All articles</a>
    <FollowLinkedIn />
  </div>
</PageLayout>
