---
import PageLayout from '@layouts/PageLayout.astro';
import { GraduationCap, ArrowUpRight } from '@lucide/astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import LinkedinIcon from '@components/icons/LinkedinIcon.astro';
import MediumIcon from '@components/icons/MediumIcon.astro';
import OrcidIcon from '@components/icons/OrcidIcon.astro';
import TopmateCTA from '@components/TopmateCTA.astro';
import { getProfile } from '@lib/content';

const { data: p } = await getProfile();
const channels = [
  { href: p.socials.linkedin, title: 'LinkedIn', note: 'Connect professionally', Icon: LinkedinIcon, external: true },
  { href: p.socials.github, title: 'GitHub', note: "See what I'm building", Icon: GithubIcon, external: true },
  { href: p.socials.medium, title: 'Medium', note: 'Read my articles', Icon: MediumIcon, external: true },
  {
    href: p.socials.scholar,
    title: 'Google Scholar',
    note: 'Research publications',
    Icon: GraduationCap,
    external: true,
  },
  { href: p.socials.orcid, title: 'ORCID', note: 'Researcher identifier', Icon: OrcidIcon, external: true },
].filter((c) => c.href);
---

<PageLayout
  title="Contact"
  description="Want to work together, talk about a role, or just ask a question about AI agents? Here's how to reach me."
  eyebrow="Say hello"
  crumbs={[{ label: 'Contact' }]}
>
  <TopmateCTA />
  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      channels.map(({ href, title, note, Icon, external }, i) => (
        <a
          href={href}
          class:list={['card card-hover group flex items-center gap-4 p-5', `reveal-i-${(i % 5) + 1}`]}
          data-reveal
          {...(external ? { target: '_blank', rel: 'me noopener noreferrer' } : {})}
        >
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
            <Icon class="h-5 w-5" aria-hidden="true" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-semibold text-fg">{title}</span>
            <span class="block truncate text-sm text-fg-muted">{note}</span>
          </span>
          <ArrowUpRight class="h-4 w-4 text-fg-faint transition-colors group-hover:text-accent" aria-hidden="true" />
        </a>
      ))
    }
  </div>
</PageLayout>
