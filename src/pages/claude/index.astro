---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import {
  ArrowRight,
  BadgeCheck,
  BookOpen,
  Clock,
  GraduationCap,
  Timer,
  Layers,
  Library,
  Coffee,
  ExternalLink,
} from '@lucide/astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import { getProfile } from '@lib/content';
import { formatDate, byDateDesc } from '@utils/format';
import claudeStats from '../../data/claude-stats.json';

const { data: profile } = await getProfile();
const certs = (await getCollection('certifications'))
  .filter((c) => c.data.title.includes('Claude Certified Architect'))
  .sort(byDateDesc((c) => c.data.date));
const exams = (await getCollection('claudeExams')).sort(
  (a, b) => (a.data.status === 'live' ? -1 : 1) - (b.data.status === 'live' ? -1 : 1),
);
const EXAM_REPO = 'https://github.com/sarveshtalele/claude-architect-exam-guide';
---

<PageLayout
  title="Claude Prep"
  description={`Two Anthropic certifications, a free mock exam, a ${claudeStats.total}-question study library, and the open-source exam guide. Everything I build and teach about Claude, in one place.`}
  eyebrow="Anthropic · Claude Certified Architect"
  crumbs={[{ label: 'Claude Prep' }]}
>
  {/* Credentials */}
  <div class="grid gap-6 sm:grid-cols-2">
    {
      certs.map((cert, i) => (
        <div class:list={['card flex items-center gap-5 p-6', `reveal-i-${i + 1}`]} data-reveal>
          {cert.data.badge && (
            <img
              src={cert.data.badge}
              alt={`${cert.data.title} badge`}
              width="112"
              height="112"
              class="h-24 w-24 shrink-0 object-contain drop-shadow-lg sm:h-28 sm:w-28"
            />
          )}
          <div class="min-w-0">
            <p class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-accent">
              {cert.data.issuer} · {formatDate(cert.data.date)}
            </p>
            <p class="mt-1 font-display text-2xl font-semibold leading-tight text-fg">
              {cert.data.title.replace('Claude Certified Architect: ', '')}
            </p>
            <p class="text-sm text-fg-muted">Claude Certified Architect</p>
            {cert.data.credentialUrl && (
              <a href={cert.data.credentialUrl} target="_blank" rel="noopener noreferrer" class="verify-btn mt-3">
                <BadgeCheck class="h-3.5 w-3.5" aria-hidden="true" /> Verify on Credly{' '}
                <ExternalLink class="h-3 w-3" aria-hidden="true" />
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>

  {/* Practice */}
  <section class="mt-20">
    <p class="eyebrow">Practice, free</p>
    <h2 class="mt-3 font-display text-4xl font-semibold text-fg sm:text-5xl">Prepare for CCAR-F</h2>
    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4" data-reveal>
      {
        [
          { v: claudeStats.total, l: 'Practice questions', I: Library },
          { v: claudeStats.mock, l: 'In the timed mock', I: Timer },
          { v: claudeStats.tasks, l: 'Task statements', I: Layers },
          { v: claudeStats.domains, l: 'Exam domains', I: BookOpen },
        ].map(({ v, l, I }) => (
          <div class="card p-4">
            <I class="h-4 w-4 text-accent" aria-hidden="true" />
            <p class="mt-2 font-display text-4xl font-semibold leading-none text-fg" data-count>
              {v}
            </p>
            <p class="mt-1 text-xs text-fg-muted">{l}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-3">
      <a href="/claude/quiz" class="claude-tile card card-hover group flex flex-col p-7 lg:col-span-2" data-reveal>
        <span class="chip chip-gold w-fit"
          ><GraduationCap class="h-3.5 w-3.5" aria-hidden="true" /> Exam conditions</span
        >
        <h3 class="mt-4 font-display text-3xl font-semibold text-fg sm:text-4xl">The mock exam</h3>
        <p class="mt-2 max-w-xl flex-1 text-fg-muted">
          {claudeStats.mock} questions, 120 minutes, scored by domain like the real CCAR-F. Or switch to untimed practice
          for instant feedback on every option. Progress survives a refresh.
        </p>
        <span class="link-arrow mt-6 text-sm font-semibold"
          >Start now <ArrowRight class="h-4 w-4" aria-hidden="true" /></span
        >
      </a>
      <a href="/claude/review" class="claude-tile card card-hover group flex flex-col p-7" data-reveal>
        <span class="chip w-fit"><BookOpen class="h-3.5 w-3.5" aria-hidden="true" /> Study library</span>
        <h3 class="mt-4 font-display text-3xl font-semibold text-fg">Learn &amp; review</h3>
        <p class="mt-2 flex-1 text-fg-muted">
          All {claudeStats.total} questions grouped by task statement, with a test mode and the exact doc to read.
        </p>
        <span class="link-arrow mt-6 text-sm font-semibold"
          >Open library <ArrowRight class="h-4 w-4" aria-hidden="true" /></span
        >
      </a>
    </div>
    <p class="mt-4 rounded-xl border border-line bg-surface px-4 py-3 text-sm text-fg-muted">
      <strong class="text-primary">Heads up:</strong> these are original practice questions, <strong
        >not official exam questions</strong
      >, and are not affiliated with or endorsed by Anthropic.
    </p>
  </section>

  {/* Exam guides */}
  <section class="mt-20">
    <p class="eyebrow">Study guides</p>
    <h2 class="mt-3 font-display text-4xl font-semibold text-fg sm:text-5xl">Both tracks</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        exams.map((e) =>
          e.data.status === 'live' ? (
            <a href={`/claude/${e.id}`} class="card card-hover flex flex-col p-6" data-reveal>
              <span class="chip chip-gold w-fit">{e.data.code}</span>
              <h3 class="mt-3 font-display text-2xl font-semibold text-fg">{e.data.title}</h3>
              <p class="mt-2 flex-1 text-sm text-fg-muted">{e.data.description}</p>
              <span class="link-arrow mt-5 text-sm font-semibold">
                Read the guide <ArrowRight class="h-4 w-4" aria-hidden="true" />
              </span>
            </a>
          ) : (
            <div class="card flex flex-col p-6 opacity-85" data-reveal>
              <span class="chip w-fit">
                <Clock class="h-3.5 w-3.5" aria-hidden="true" /> {e.data.code} · Coming soon
              </span>
              <h3 class="mt-3 font-display text-2xl font-semibold text-fg">{e.data.title}</h3>
              <p class="mt-2 flex-1 text-sm text-fg-muted">{e.data.description}</p>
              <a
                href={e.data.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="link-arrow mt-5 text-sm font-semibold"
              >
                Follow on GitHub <ExternalLink class="h-3.5 w-3.5" aria-hidden="true" />
              </a>
            </div>
          ),
        )
      }
      <a
        href={EXAM_REPO}
        target="_blank"
        rel="noopener noreferrer"
        class="card card-hover flex flex-col p-6"
        data-reveal
      >
        <span class="chip w-fit"><GithubIcon class="h-3.5 w-3.5" /> Open source</span>
        <h3 class="mt-3 font-display text-2xl font-semibold text-fg">Exam guide repo</h3>
        <p class="mt-2 flex-1 text-sm text-fg-muted">
          The study hub: blueprints, a slash-command study skill, and copy-paste prompt packs for learning and mock
          tests.
        </p>
        <img
          src="https://img.shields.io/github/stars/sarveshtalele/claude-architect-exam-guide?style=for-the-badge&logo=github&label=Stars&color=a67c3d"
          alt="GitHub stars for claude-architect-exam-guide"
          height="28"
          loading="lazy"
          class="mt-5 h-7 w-fit"
        />
      </a>
    </div>
  </section>

  {/* Products */}
  {
    profile.socials.topmate && (
      <section class="mt-20">
        <div class="card flex flex-col gap-6 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8" data-reveal>
          <div class="max-w-2xl">
            <span class="chip chip-gold w-fit">
              <Coffee class="h-3.5 w-3.5" aria-hidden="true" /> 1:1 sessions
            </span>
            <h2 class="mt-3 font-display text-3xl font-semibold text-fg">Architecture reviews &amp; exam coaching</h2>
            <p class="mt-2 text-fg-muted">
              Claude architecture reviews, CCAR-F/P exam prep, and hands-on build sessions. Book directly.
            </p>
          </div>
          <a
            href={profile.socials.topmate}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary relative inline-flex shrink-0 items-center justify-center gap-2 overflow-hidden rounded-full px-6 py-3 text-sm font-semibold"
          >
            Book on Topmate <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </section>
    )
  }
</PageLayout>
