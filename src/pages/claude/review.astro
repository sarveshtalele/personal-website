---
import PageLayout from '@layouts/PageLayout.astro';
import claudeStats from '../../data/claude-stats.json';
---

<PageLayout
  title="Learn & Review"
  description={`Every one of my ${claudeStats.total} CCAR-F practice questions on one page, grouped by topic. Search them, hide the answers to test yourself, and open the Claude doc behind each one.`}
  eyebrow="Claude · Learn & Review"
  crumbs={[{ label: 'Claude Prep', href: '/claude' }, { label: 'Learn & Review' }]}
>
  <div class="review" id="review-app" data-q="/claude/review/questions.json" data-c="/claude/review/concepts.json">
    <ul class="review-stats" aria-label="Library at a glance">
      <li><strong>{claudeStats.total}</strong> questions</li>
      <li><strong>{claudeStats.domains}</strong> domains</li>
      <li><strong>{claudeStats.tasks}</strong> task statements</li>
      <li><strong>1</strong> doc link per question</li>
    </ul>
    <p class="review-warning" role="note">
      <strong>Unofficial.</strong> I wrote these to practise for the exam. They aren't real exam questions and aren't endorsed
      by Anthropic, but every one links to the Claude doc that explains it.
    </p>

    <div class="review-bar" role="search">
      <div class="review-bar-row">
        <label class="review-search-wrap">
          <span class="sr-only">Filter questions by keyword</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
          >
          <input
            id="review-search"
            type="search"
            placeholder="Search questions, e.g. stop_reason, hooks, MCP…"
            autocomplete="off"
          />
          <button type="button" class="review-clear" id="review-clear" aria-label="Clear search" hidden>Clear</button>
        </label>
        <label class="review-switch">
          <input type="checkbox" id="review-testmode" role="switch" />
          <span class="track" aria-hidden="true"><span class="thumb"></span></span>
          <span class="label">Test mode <span class="hint">hide answers</span></span>
        </label>
        <span class="review-count" id="review-count" aria-live="polite"></span>
      </div>
      <nav class="review-jump" aria-label="Jump to domain">
        <span>Jump to</span>
        {[1, 2, 3, 4, 5].slice(0, claudeStats.domains).map((d) => <a href={`#d${d}`}>Domain {d}</a>)}
      </nav>
    </div>

    <div class="review-layout">
      <nav class="review-toc" id="review-toc" aria-label="Contents">
        <p class="review-toc-title">On this page</p>
        <div id="review-toc-list"><p class="review-muted">Loading…</p></div>
      </nav>
      <div class="review-content" id="review-content">
        <p class="review-muted">Loading {claudeStats.total} questions…</p>
      </div>
    </div>
    <button id="review-top" class="review-top" type="button" aria-label="Back to top" hidden>&uarr; Top</button>
  </div>
</PageLayout>

<style is:global>
  .review {
    --r-bg: var(--bg-alt);
    --r-card: var(--card);
    --r-ink: var(--fg);
    --r-muted: var(--fg-muted);
    --r-line: var(--border);
    --r-chip: var(--surface);
    --r-accent: var(--primary);
    --r-accent-strong: var(--accent);
    --r-good: var(--success);
    --r-good-soft: color-mix(in srgb, var(--success) 14%, var(--card));
    --r-bad: var(--danger);
    --r-bad-soft: color-mix(in srgb, var(--danger) 14%, var(--card));
    color: var(--r-ink);
  }
  .review-muted {
    color: var(--r-muted);
  }
  .review-warning {
    border: 1px solid var(--r-line);
    background: var(--r-chip);
    border-radius: 0.9rem;
    padding: 0.85rem 1.05rem;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  .review-warning strong {
    color: var(--r-accent-strong);
  }
  .review-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .review-stats li {
    border: 1px solid var(--r-line);
    background: var(--r-card);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    font-size: 0.85rem;
    color: var(--r-muted);
  }
  .review-stats strong {
    color: var(--r-ink);
    font-size: 1rem;
  }

  /* Sticky control bar: the main way to use a 360-question page. */
  .review-bar {
    position: sticky;
    top: 4.5rem;
    z-index: 30;
    margin: 0 -0.5rem 1.5rem;
    padding: 0.85rem;
    border: 1px solid var(--r-line);
    border-radius: 1.1rem;
    background: color-mix(in srgb, var(--r-card) 92%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: var(--shadow-card);
  }
  .review-bar-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .review-search-wrap {
    position: relative;
    flex: 1 1 18rem;
    display: flex;
    align-items: center;
  }
  .review-search-wrap svg {
    position: absolute;
    left: 0.95rem;
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: var(--r-muted);
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }
  #review-search {
    width: 100%;
    height: 3rem;
    border: 1.5px solid var(--r-line);
    background: var(--bg);
    color: var(--r-ink);
    border-radius: 0.85rem;
    padding: 0 4.5rem 0 2.75rem;
    font-size: 1rem;
  }
  #review-search:focus {
    outline: none;
    border-color: var(--r-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--r-accent) 18%, transparent);
  }
  #review-search::-webkit-search-cancel-button {
    display: none;
  }
  .review-clear {
    position: absolute;
    right: 0.5rem;
    border-radius: 0.6rem;
    padding: 0.35rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--r-accent);
    background: var(--r-chip);
  }
  .review-clear[hidden] {
    display: none;
  }
  .review-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0 0.85rem;
    border: 1.5px solid var(--r-line);
    border-radius: 0.85rem;
    cursor: pointer;
    user-select: none;
  }
  .review-switch input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .review-switch .track {
    position: relative;
    width: 2.6rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--r-line);
    transition: background-color 200ms ease;
  }
  .review-switch .thumb {
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.3);
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .review-switch input:checked + .track {
    background: var(--r-accent);
  }
  .review-switch input:checked + .track .thumb {
    transform: translateX(1.1rem);
  }
  .review-switch input:focus-visible + .track {
    outline: 2px solid var(--r-accent);
    outline-offset: 2px;
  }
  .review-switch .label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--r-ink);
  }
  .review-switch .hint {
    display: block;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--r-muted);
  }
  .review-count {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1rem;
    border-radius: 0.85rem;
    background: var(--r-accent);
    color: var(--on-primary);
    font-size: 0.9rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .review-jump {
    white-space: nowrap;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--r-muted);
  }
  .review-jump a {
    border: 1px solid var(--r-line);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font-weight: 600;
    color: var(--r-ink);
  }
  .review-jump a:hover {
    border-color: var(--r-accent);
    color: var(--r-accent);
  }
  .review-top {
    display: none !important;
  }
  @media (max-width: 640px) {
    .review-bar {
      top: 4.25rem;
      margin: 0 -0.25rem 1.25rem;
      padding: 0.6rem;
    }
    .review-switch .hint {
      display: none;
    }
    .review-jump {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-top: 0.6rem;
      scrollbar-width: none;
    }
    .review-jump a {
      flex-shrink: 0;
    }
    .review-switch,
    .review-count,
    #review-search {
      min-height: 2.75rem;
      height: 2.75rem;
    }
  }

  .review-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .review-layout {
      grid-template-columns: 260px minmax(0, 1fr);
      align-items: start;
    }
  }

  /* Docs-style sidebar: its own independent scroll, sticky under the navbar. */
  .review-toc {
    align-self: start;
  }
  /* Below desktop the domain chips in the control bar replace the long sidebar. */
  @media (max-width: 1023px) {
    .review-toc {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .review-toc {
      position: sticky;
      top: 12.5rem;
      height: calc(100vh - 13.5rem);
      overflow-y: auto;
      padding-right: 0.4rem;
    }
  }
  .review-toc-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--r-muted);
    padding: 0 0.25rem 0.5rem;
  }
  .review-toc details {
    border-bottom: 1px solid var(--r-line);
  }
  .review-toc summary {
    cursor: pointer;
    padding: 0.5rem 0.25rem;
    font-weight: 700;
    font-size: 0.88rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    align-items: center;
  }
  .review-toc summary::-webkit-details-marker {
    display: none;
  }
  .review-toc .toc-right {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }
  .review-toc .toc-w {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--r-accent);
  }
  .review-toc .toc-chev {
    font-size: 0.7rem;
    color: var(--r-muted);
    transition: transform 0.15s ease;
  }
  .review-toc details[open] .toc-chev {
    transform: rotate(90deg);
  }
  .review-toc details[open] > summary .toc-dom,
  .review-toc summary:hover .toc-dom {
    color: var(--r-accent);
  }
  .review-toc a {
    display: block;
    padding: 0.28rem 0.25rem 0.28rem 0.85rem;
    font-size: 0.82rem;
    color: var(--r-muted);
    text-decoration: none;
    border-left: 2px solid var(--r-line);
  }
  .review-toc a:hover {
    color: var(--r-ink);
    border-left-color: var(--r-accent);
  }
  .review-toc a.active {
    color: var(--r-accent);
    border-left-color: var(--r-accent);
    font-weight: 600;
    background: var(--r-chip);
  }

  .review-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    border: 1px solid var(--r-line);
    background: var(--r-accent);
    color: var(--on-primary);
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: var(--shadow-card-hover);
  }
  .review-top[hidden] {
    display: none;
  }

  .r-domain {
    margin-top: 2.5rem;
    scroll-margin-top: 13rem;
  }
  .r-domain:first-child {
    margin-top: 0;
  }
  .r-domain-head {
    border-bottom: 2px solid var(--r-line);
    padding-bottom: 0.4rem;
  }
  .r-domain-head h2 {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .r-domain-head .w {
    font-size: 0.8rem;
    color: var(--r-accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .r-concepts {
    margin-top: 1rem;
    display: grid;
    gap: 0.6rem;
  }
  .r-concept {
    border: 1px solid var(--r-line);
    background: var(--r-chip);
    border-radius: 0.7rem;
    padding: 0.7rem 0.9rem;
    font-size: 0.88rem;
  }
  .r-concept .t {
    font-weight: 700;
    color: var(--r-ink);
  }
  .r-concept .s {
    color: var(--r-muted);
    margin-top: 0.15rem;
    line-height: 1.5;
  }
  .r-concept a {
    color: var(--r-accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .r-concept a:hover {
    text-decoration: underline;
  }

  .r-task {
    margin-top: 1.6rem;
    scroll-margin-top: 13rem;
  }
  .r-task h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--r-accent-strong);
  }

  /* content-visibility lets the browser skip layout/paint for off-screen
     cards — critical with 360 questions on one page. */
  .r-q {
    border: 1px solid var(--r-line);
    background: var(--r-card);
    border-radius: 0.8rem;
    padding: 1.1rem 1.2rem;
    margin-top: 0.9rem;
    box-shadow: var(--shadow-card);
    content-visibility: auto;
    contain-intrinsic-size: 0 260px;
  }
  .r-q .qid {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--r-muted);
    letter-spacing: 0.03em;
  }
  .r-q .stem {
    font-weight: 600;
    line-height: 1.55;
    margin-top: 0.3rem;
  }
  .r-opts {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.8rem;
  }
  .r-opt {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    border: 1px solid var(--r-line);
    border-radius: 0.6rem;
    padding: 0.55rem 0.75rem;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .r-opt .l {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.4rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--r-line);
    font-weight: 700;
    font-size: 0.78rem;
    background: var(--r-chip);
  }
  .r-answered .r-opt.correct {
    border-color: var(--r-good);
    background: var(--r-good-soft);
  }
  .r-answered .r-opt.correct .l {
    background: var(--r-good);
    color: #fff;
    border-color: var(--r-good);
  }
  .r-ans {
    margin-top: 0.85rem;
    border: 1px solid var(--r-line);
    border-radius: 0.6rem;
    overflow: hidden;
  }
  .r-ans .row {
    padding: 0.6rem 0.85rem;
    font-size: 0.88rem;
    line-height: 1.55;
    border-top: 1px solid var(--r-line);
  }
  .r-ans .row:first-child {
    border-top: none;
  }
  .r-ans .row.good {
    background: var(--r-good-soft);
  }
  .r-ans .row .lab {
    font-weight: 700;
  }
  .r-ans .row.good .lab {
    color: var(--r-good);
  }
  .r-ans .row.why .lab {
    color: var(--r-muted);
  }
  .r-doc {
    margin-top: 0.7rem;
    font-size: 0.85rem;
  }
  .r-doc a {
    color: var(--r-accent);
    font-weight: 600;
    text-decoration: none;
  }
  .r-doc a:hover {
    text-decoration: underline;
  }
  code {
    background: var(--r-chip);
    border: 1px solid var(--r-line);
    border-radius: 4px;
    padding: 0 0.25rem;
    font-size: 0.85em;
  }

  /* Test mode: for cards not yet revealed, hide the answer/doc AND neutralize
     every trace of the correct option (border, background, and letter badge). */
  .r-reveal {
    display: none;
    margin-top: 0.7rem;
  }
  .review.testmode .r-q:not(.revealed) .r-ans,
  .review.testmode .r-q:not(.revealed) .r-doc {
    display: none;
  }
  .review.testmode .r-q:not(.revealed) .r-reveal {
    display: block;
  }
  .review.testmode .r-q:not(.revealed) .r-opt.correct {
    border-color: var(--r-line);
    background: var(--r-card);
  }
  .review.testmode .r-q:not(.revealed) .r-opt.correct .l {
    background: var(--r-chip);
    color: var(--r-ink);
    border-color: var(--r-line);
  }
  .r-reveal button {
    border: 1px solid var(--r-line);
    background: var(--r-chip);
    color: var(--r-ink);
    border-radius: 0.5rem;
    padding: 0.35rem 0.8rem;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }
</style>

<script>
  type Q = {
    id: string;
    domain: number;
    task: string;
    ptask: string;
    scenario: number;
    stem: string;
    options: Record<'A' | 'B' | 'C' | 'D', string>;
    answer: string;
    explanation: string;
    distractors: Record<string, string>;
    official: boolean;
    docLabel: string;
    docUrl: string;
  };
  type Concept = {
    domain: number;
    domainName: string;
    weight: string;
    task: string;
    title: string;
    summary: string;
    docUrl: string;
  };
  const LETTERS = ['A', 'B', 'C', 'D'] as const;

  const root = document.getElementById('review-app')!;
  const tocListEl = document.getElementById('review-toc-list')!;
  const contentEl = document.getElementById('review-content')!;
  const countEl = document.getElementById('review-count')!;
  const topBtn = document.getElementById('review-top') as HTMLButtonElement;

  function esc(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }
  function md(s: string) {
    let o = esc(s);
    o = o.replace(/`([^`]+)`/g, (_, t) => `<code>${t}</code>`);
    o = o.replace(/\*\*([^*]+)\*\*/g, (_, t) => `<strong>${t}</strong>`);
    o = o.replace(/\*([^*]+)\*/g, (_, t) => `<em>${t}</em>`);
    return o;
  }

  function questionHtml(q: Q): string {
    const opts = LETTERS.map((l) => {
      const cls = 'r-opt' + (l === q.answer ? ' correct' : '');
      return `<div class="${cls}"><span class="l">${l}</span><span>${md(q.options[l])}</span></div>`;
    }).join('');
    const others = LETTERS.filter((l) => l !== q.answer)
      .map((l) => {
        const r = q.distractors[l];
        return r ? `<div class="row why"><span class="lab">Why not ${l}:</span> ${md(r)}</div>` : '';
      })
      .join('');
    return `<div class="r-q r-answered" data-text="${esc((q.stem + ' ' + Object.values(q.options).join(' ')).toLowerCase())}">
      <div class="qid">${q.id}${q.official ? ' · exam-style ★' : ''}</div>
      <p class="stem">${md(q.stem)}</p>
      <div class="r-opts">${opts}</div>
      <div class="r-reveal"><button type="button">Reveal answer</button></div>
      <div class="r-ans">
        <div class="row good"><span class="lab">Correct answer: ${q.answer}.</span> ${md(q.explanation)}</div>
        ${others}
      </div>
      <p class="r-doc">📖 If unsure, review: <a href="${esc(q.docUrl)}" target="_blank" rel="noopener noreferrer">${esc(q.docLabel)} →</a></p>
    </div>`;
  }

  async function boot() {
    let questions: Q[], concepts: Concept[];
    try {
      [questions, concepts] = await Promise.all([
        fetch(root.dataset.q!).then((r) => {
          if (!r.ok) throw 0;
          return r.json();
        }),
        fetch(root.dataset.c!).then((r) => {
          if (!r.ok) throw 0;
          return r.json();
        }),
      ]);
    } catch {
      contentEl.innerHTML = '<p class="review-muted">Couldn\'t load the question bank. Please refresh.</p>';
      return;
    }

    const domains = [...new Set(questions.map((q) => q.domain))].sort();
    const conceptsByDom: Record<number, Concept[]> = {};
    concepts.forEach((c) => {
      (conceptsByDom[c.domain] ??= []).push(c);
    });

    let toc = '',
      content = '';
    for (const d of domains) {
      const dq = questions.filter((q) => q.domain === d);
      const dname = conceptsByDom[d]?.[0]?.domainName ?? `Domain ${d}`;
      const weight = conceptsByDom[d]?.[0]?.weight ?? '';
      // group by task
      const tasks = [...new Set(dq.map((q) => q.ptask))].sort();
      // TOC (collapsible dropdown per domain)
      toc += `<details data-domain="${d}"><summary><span class="toc-dom">D${d} · ${esc(dname)}</span><span class="toc-right"><span class="toc-w">${weight}</span><span class="toc-chev">▸</span></span></summary>`;
      for (const t of tasks) {
        const tc = conceptsByDom[d]?.find((c) => c.task === t);
        const tid = 't' + t.replace('.', '-');
        const title = tc?.title ?? '';
        const short = title.length > 38 ? title.slice(0, 38) + '…' : title;
        toc += `<a href="#${tid}" data-toc="${tid}">${t} · ${esc(short)} <span style="opacity:.6">(${dq.filter((q) => q.ptask === t).length})</span></a>`;
      }
      toc += `</details>`;
      // content: domain head + concepts + questions
      content += `<section class="r-domain" id="d${d}"><div class="r-domain-head"><p class="w">Domain ${d} · ${weight}</p><h2>${esc(dname)}</h2></div>`;
      content += `<div class="r-concepts">`;
      for (const c of conceptsByDom[d] ?? []) {
        content += `<div class="r-concept"><div style="display:flex;justify-content:space-between;gap:.75rem;align-items:baseline">
          <span class="t">${c.task} · ${esc(c.title)}</span>
          <a href="${c.docUrl}" target="_blank" rel="noopener">Read the docs →</a></div>
          <div class="s">${md(c.summary)}</div></div>`;
      }
      content += `</div>`;
      for (const t of tasks) {
        const tc = conceptsByDom[d]?.find((c) => c.task === t);
        content += `<div class="r-task" id="t${t.replace('.', '-')}" data-domain="${d}"><h3>Task ${t}${tc ? `: ${esc(tc.title)}` : ''}</h3>`;
        for (const q of dq.filter((x) => x.ptask === t)) content += questionHtml(q);
        content += `</div>`;
      }
      content += `</section>`;
    }
    tocListEl.innerHTML = toc;
    contentEl.innerHTML = content;
    countEl.textContent = `${questions.length} questions`;

    // reveal buttons (test mode)
    contentEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.r-reveal button');
      if (btn) btn.closest('.r-q')?.classList.add('revealed');
    });
    // test mode toggle
    document.getElementById('review-testmode')!.addEventListener('change', (e) => {
      const on = (e.target as HTMLInputElement).checked;
      root.classList.toggle('testmode', on);
      if (!on) contentEl.querySelectorAll('.r-q.revealed').forEach((q) => q.classList.remove('revealed'));
    });
    // search filter
    const search = document.getElementById('review-search') as HTMLInputElement;
    const clearBtn = document.getElementById('review-clear') as HTMLButtonElement;
    clearBtn.addEventListener('click', () => {
      search.value = '';
      search.dispatchEvent(new Event('input'));
      search.focus();
    });
    search.addEventListener('input', () => {
      clearBtn.hidden = !search.value;
      const term = search.value.trim().toLowerCase();
      let shown = 0;
      contentEl.querySelectorAll<HTMLElement>('.r-q').forEach((card) => {
        const match = !term || (card.dataset.text ?? '').includes(term);
        card.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      // hide empty task/domain groups
      contentEl.querySelectorAll<HTMLElement>('.r-task').forEach((t) => {
        const any = [...t.querySelectorAll<HTMLElement>('.r-q')].some((q) => q.style.display !== 'none');
        t.style.display = any ? '' : 'none';
      });
      contentEl.querySelectorAll<HTMLElement>('.r-domain').forEach((s) => {
        const any = [...s.querySelectorAll<HTMLElement>('.r-q')].some((q) => q.style.display !== 'none');
        s.querySelectorAll<HTMLElement>('.r-concepts, .r-domain-head').forEach((el) => {
          el.style.opacity = any ? '1' : '0.4';
        });
      });
      countEl.textContent = term ? `${shown} match${shown === 1 ? '' : 'es'}` : `${questions.length} questions`;
    });
    // ---- sidebar navigation + scrollspy ----
    const taskLinks = new Map<string, HTMLElement>();
    tocListEl.querySelectorAll<HTMLElement>('a[data-toc]').forEach((a) => taskLinks.set(a.dataset.toc!, a));
    const detailsEls = [...tocListEl.querySelectorAll<HTMLDetailsElement>('details[data-domain]')];
    const domainEls = [...contentEl.querySelectorAll<HTMLElement>('.r-domain')];
    const taskEls = [...contentEl.querySelectorAll<HTMLElement>('.r-task')];

    // Clicking a domain scrolls to that domain section (its concept / knowledge
    // cards), in addition to the native open/close toggle.
    detailsEls.forEach((det) => {
      const dom = det.dataset.domain!;
      det.querySelector('summary')?.addEventListener('click', () => {
        requestAnimationFrame(() =>
          document.getElementById('d' + dom)?.scrollIntoView({ behavior: 'smooth', block: 'start' }),
        );
      });
    });

    let activeTask = '',
      activeDom = '',
      ticking = false;
    const LINE = 220; // px below the sticky navbar + control bar treated as the "current" line
    function spy() {
      ticking = false;
      // active domain = last .r-domain whose top has crossed the line
      let curDom: HTMLElement | null = domainEls[0] ?? null;
      for (const el of domainEls) {
        if (el.getBoundingClientRect().top <= LINE) curDom = el;
        else break;
      }
      const dom = curDom ? curDom.id.slice(1) : '';
      // active task = last crossed .r-task that belongs to the active domain
      let curTask: HTMLElement | null = null;
      for (const el of taskEls) {
        if (el.getBoundingClientRect().top <= LINE) {
          if (el.dataset.domain === dom) curTask = el;
        } else break;
      }
      // when reading a domain's concept area (before its first task), point at its first task
      if (!curTask && dom) curTask = taskEls.find((el) => el.dataset.domain === dom) ?? null;

      if (dom && dom !== activeDom) {
        activeDom = dom;
        detailsEls.forEach((det) => {
          det.open = det.dataset.domain === dom;
        });
      }
      const tid = curTask ? curTask.id : '';
      if (tid !== activeTask) {
        activeTask = tid;
        taskLinks.forEach((a) => a.classList.remove('active'));
        const link = tid ? taskLinks.get(tid) : null;
        if (link) {
          link.classList.add('active');
          link.scrollIntoView({ block: 'nearest' });
        }
      }
      topBtn.hidden = window.scrollY < 600;
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(spy);
        }
      },
      { passive: true },
    );
    topBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    spy();
  }
  boot();
</script>
