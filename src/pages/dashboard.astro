---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import ImpactGrid from '@components/ImpactGrid.astro';
import GithubPanel from '@components/GithubPanel.astro';
import CredentialWall from '@components/CredentialWall.astro';
import VerifiedBadges from '@components/VerifiedBadges.astro';
import SkillsDashboard from '@components/SkillsDashboard.astro';
import Icon from '@components/Icon.astro';
import { ArrowUpRight, FlaskConical } from '@lucide/astro';
import { getDashboard } from '@lib/content';
import { byDateDesc, formatDate } from '@utils/format';
import claudeStats from '../data/claude-stats.json';

const dashboard = await getDashboard();
const publications = (await getCollection('publications')).sort(byDateDesc((p) => p.data.pubDate));
const experience = (await getCollection('experience')).sort(byDateDesc((e) => e.data.startDate));
const current = experience.find((e) => e.data.current);
const isExternal = (href: string) => href.startsWith('http');
---

<PageLayout title="Dashboard" description={dashboard.intro} eyebrow={dashboard.title} crumbs={[{ label: 'Dashboard' }]}>
  <div class="mb-12" data-reveal>
    <VerifiedBadges />
  </div>

  {
    current && (
      <div class="card card-gilded mb-12 grid gap-6 p-6 sm:grid-cols-[auto_1fr] sm:items-center sm:p-8" data-reveal>
        <span class="relative flex h-3 w-3">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success opacity-60" />
          <span class="relative inline-flex h-3 w-3 rounded-full bg-success" />
        </span>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-fg-faint">Currently</p>
          <p class="mt-1 font-display text-2xl font-semibold text-fg sm:text-3xl">
            {current.data.role} at {current.data.company}
          </p>
          <p class="mt-1 text-sm text-fg-muted">
            Since {formatDate(current.data.startDate)} · {current.data.location}
          </p>
        </div>
      </div>
    )
  }

  <h2 class="font-display text-3xl font-semibold text-fg sm:text-4xl" data-reveal>Production impact</h2>
  <p class="mb-6 mt-2 text-sm text-fg-muted">From enterprise deployments at TCS. Click any tile for the source.</p>
  <ImpactGrid />

  <h2 class="mt-16 font-display text-3xl font-semibold text-fg sm:text-4xl" data-reveal>Open source</h2>
  <p class="mb-6 mt-2 text-sm text-fg-muted">Computed from the public GitHub API, not typed by hand.</p>
  <GithubPanel />

  <div class="mt-16 grid gap-6 lg:grid-cols-3">
    {
      dashboard.highlights.map((h, i) => (
        <a
          href={h.href}
          class:list={['card card-hover card-gilded group flex flex-col gap-3 p-6', `reveal-i-${i + 1}`]}
          data-reveal
          {...(isExternal(h.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent-soft text-accent">
            <Icon name={h.icon} class="h-5 w-5" />
          </span>
          <p class="font-display text-2xl font-semibold text-fg">{h.title}</p>
          <p class="flex-1 text-sm text-fg-muted">{h.description}</p>
          <span class="link-arrow text-sm font-medium">
            {h.linkLabel} <ArrowUpRight class="h-3.5 w-3.5" aria-hidden="true" />
          </span>
        </a>
      ))
    }
  </div>

  <h2 class="mt-16 font-display text-3xl font-semibold text-fg sm:text-4xl" data-reveal>Verified credentials</h2>
  <p class="mb-6 mt-2 text-sm text-fg-muted">Badges link to the issuer's own verification page.</p>
  <CredentialWall />

  <h2 class="mt-16 font-display text-3xl font-semibold text-fg sm:text-4xl" data-reveal>Research</h2>
  <div class="mt-6 space-y-4">
    {
      publications.map((p) => (
        <div class="card flex items-start gap-4 p-6" data-reveal>
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
            <FlaskConical class="h-5 w-5" aria-hidden="true" />
          </span>
          <div class="min-w-0">
            {p.data.url ? (
              <a
                href={p.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-fg hover:text-primary"
              >
                {p.data.title}
              </a>
            ) : (
              <p class="font-semibold text-fg">{p.data.title}</p>
            )}
            <p class="mt-1 text-xs text-fg-faint">
              {p.data.venue} · {formatDate(p.data.pubDate)}
            </p>
            {p.data.badges.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {p.data.badges.map((b) => (
                  <a href={b.href} target="_blank" rel="noopener noreferrer" class="verify-btn">
                    {b.label} ↗
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>

  <h2 class="mt-16 font-display text-3xl font-semibold text-fg sm:text-4xl" data-reveal>Knowledge shared</h2>
  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {
      [
        { v: claudeStats.total, l: 'Practice questions authored', h: '/claude/review' },
        { v: claudeStats.mock, l: 'Mock exam questions', h: '/claude/quiz' },
        { v: claudeStats.tasks, l: 'Task statements mapped', h: '/claude/foundations' },
        { v: claudeStats.domains, l: 'Exam domains covered', h: '/claude/foundations' },
      ].map((s) => (
        <a href={s.h} class="card card-hover flex flex-col gap-1 p-5" data-reveal>
          <span class="font-display text-4xl font-semibold text-gold" data-count>
            {s.v}
          </span>
          <span class="text-xs text-fg-muted">{s.l}</span>
        </a>
      ))
    }
  </div>

  <h2 class="mb-6 mt-16 font-display text-3xl font-semibold text-fg sm:text-4xl" data-reveal>Toolbox</h2>
  <SkillsDashboard />
</PageLayout>
