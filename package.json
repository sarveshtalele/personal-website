{
  "name": "sarveshtalele-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Personal site of Sarvesh Talele: 3D story homepage, newsletter, references, projects, and free Claude Certified Architect exam prep. All content is Markdown.",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "prepare:data": "node scripts/build-claude-data.mjs && node scripts/build-claude-pdf.mjs && node scripts/verify-claude-pdf.mjs && node scripts/fetch-github.mjs",
    "dev": "node scripts/build-claude-data.mjs && astro dev",
    "build": "pnpm prepare:data && node scripts/validate-content.mjs && astro build && node scripts/csp.mjs && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "check:content": "node scripts/build-claude-data.mjs && node scripts/validate-content.mjs",
    "claude:build": "node scripts/build-claude-data.mjs",
    "github:sync": "node scripts/fetch-github.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "claude:pdf": "node scripts/build-claude-data.mjs && node scripts/build-claude-pdf.mjs && node scripts/verify-claude-pdf.mjs",
    "new:article": "node scripts/new-article.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.7",
    "katex": "^0.17.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/three": "^0.187.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^2.1.1",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "0.21.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
