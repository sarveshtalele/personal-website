{
  "name": "sarveshtalele-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Personal site of Sarvesh Talele: AI engineering portfolio, blog, and free Claude Certified Architect exam prep. All content is Markdown.",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "prepare:data": "node scripts/build-claude-data.mjs && node scripts/fetch-github.mjs",
    "dev": "node scripts/build-claude-data.mjs && astro dev",
    "build": "pnpm prepare:data && node scripts/validate-content.mjs && astro build && node scripts/csp.mjs && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "check:content": "node scripts/build-claude-data.mjs && node scripts/validate-content.mjs",
    "claude:build": "node scripts/build-claude-data.mjs",
    "github:sync": "node scripts/fetch-github.mjs",
    "new:blog": "node scripts/new-blog.mjs",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "katex": "^0.17.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^2.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
